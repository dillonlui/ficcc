---
import '../styles/global.css';
import cjkFontsHref from '../styles/cjk-fonts.css?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { getPageVisibility, getSanityPreviewContext, getSiteBranding, getSiteSettings } from '../lib/sanity';
import { VisualEditing } from '@sanity/astro/visual-editing';
import Analytics from '@vercel/analytics/astro';
import { getAlternateUrl, hasLanguageCounterpart, type Lang } from '../lib/navigation';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  alternatePath?: string;
}

const {
  title,
  description = 'A Chinese-heritage, university-adjacent Christian community in Ithaca, NY.',
  lang = 'en',
  jsonLd,
  ogImage,
  ogType,
  noindex = false,
  alternatePath,
} = Astro.props;

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const enableVercelAnalytics =
  import.meta.env.VERCEL === '1' ||
  import.meta.env.PUBLIC_VERCEL_ANALYTICS_ENABLED === 'true';

const alternateUrl = getAlternateUrl(Astro.url.pathname, lang as Lang, alternatePath);
const absoluteAlternateUrl = new URL(alternateUrl, Astro.site ?? 'https://ficcc.org').href;
const hasAlternate = Boolean(alternatePath) || hasLanguageCounterpart(Astro.url.pathname);

let siteSettings: Awaited<ReturnType<typeof getSiteSettings>> = null;
let branding: Awaited<ReturnType<typeof getSiteBranding>> = null;
let pageVisibility: Awaited<ReturnType<typeof getPageVisibility>> = {};
const previewContext = await getSanityPreviewContext(Astro.request);
if (previewContext.enabled) {
  // Draft responses must never be stored by a browser, CDN, or shared proxy.
  Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
if (noindex) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
try {
  [siteSettings, branding, pageVisibility] = await Promise.all([
    getSiteSettings(lang as Lang, { request: Astro.request }),
    getSiteBranding({ request: Astro.request }),
    getPageVisibility(lang as Lang, { request: Astro.request }),
  ]);
} catch {
  // K008: build continues without announcement bar when CMS is unreachable
}

const showAnnouncementBar =
  siteSettings?.announcementBarEnabled && siteSettings?.announcementBarText;
const skipLinkText = lang === 'zh' ? '跳至主要內容' : 'Skip to main content';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} lang={lang} alternateUrl={hasAlternate ? absoluteAlternateUrl : undefined} jsonLd={jsonLd} ogImage={ogImage} ogType={ogType} noindex={noindex} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.add('reveal-enabled');
    </script>
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="stylesheet" href={cjkFontsHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={cjkFontsHref} /></noscript>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">{skipLinkText}</a>
    {showAnnouncementBar && (
      siteSettings.announcementBarLink ? (
        <a href={siteSettings.announcementBarLink} class="announcement-bar" role="banner">
          {siteSettings.announcementBarText}
        </a>
      ) : (
        <div class="announcement-bar" role="banner">
          {siteSettings.announcementBarText}
        </div>
      )
    )}
    <Header lang={lang} langToggleHref={alternateUrl} pageVisibility={pageVisibility} branding={branding} />
    <slot />
    <Footer lang={lang} siteSettings={siteSettings} branding={branding} />
    {previewContext.enabled && <VisualEditing enabled={true} />}
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);

          // Custom event helper for sermon_play, language_switch, form_submit
          window.sendAnalyticsEvent = function(eventName, params) {
            if (typeof gtag === 'function') {
              gtag('event', eventName, params || {});
            }
          };
        </script>
      </>
    )}
    <script>
      const skipLink = document.querySelector<HTMLAnchorElement>('.skip-to-content');
      skipLink?.addEventListener('click', () => {
        const target = document.querySelector<HTMLElement>(skipLink.hash);
        if (!target) return;

        const hadTabIndex = target.hasAttribute('tabindex');
        if (!hadTabIndex) target.setAttribute('tabindex', '-1');
        requestAnimationFrame(() => target.focus());
        if (!hadTabIndex) {
          target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
        }
      });

      document.addEventListener('click', (e) => {
        const toggle = (e.target as HTMLElement).closest('.lang-toggle') as HTMLAnchorElement | null;
        if (toggle) {
          const targetLang = toggle.href.includes('/zh') ? 'zh' : 'en';
          document.cookie = 'lang-pref=' + targetLang + ';path=/;max-age=31536000;SameSite=Lax;Secure';
        }
      });
    </script>
    <!-- Scroll-reveal observer -->
    <script>
      {
        const els = document.querySelectorAll('[data-reveal]');
        if (els.length && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            const entering = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

            const staggerCounts = new Map<Element, number>();

            entering.forEach((entry) => {
              const target = entry.target as HTMLElement;
              const staggerGroup = target.parentElement?.matches('[data-reveal-stagger]')
                ? target.parentElement
                : null;
              const staggerIndex = staggerGroup
                ? staggerCounts.get(staggerGroup) ?? 0
                : 0;

              target.style.setProperty('--reveal-delay', `${staggerIndex * 40}ms`);
              target.classList.add('is-visible');
              io.unobserve(target);

              if (staggerGroup) {
                staggerCounts.set(staggerGroup, staggerIndex + 1);
              }
            });
          }, {
            threshold: 0.01,
            rootMargin: '0px 0px 160px 0px',
          });
          els.forEach((el) => io.observe(el));
        } else {
          els.forEach((el) => el.classList.add('is-visible'));
        }
      }
    </script>
    {enableVercelAnalytics && <Analytics />}
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  body > main,
  body > [data-pagefind-body] {
    flex: 1;
  }

  .skip-to-content {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    z-index: 9999;
    padding: var(--space-3) var(--space-6);
    background: var(--color-ink);
    color: var(--color-bg);
    font-family: var(--font-body);
    font-size: var(--text-base);
    text-decoration: none;
    border-radius: var(--radius-sm, 0.25rem);
  }

  .skip-to-content:focus-visible {
    position: fixed;
    left: var(--space-4);
    top: var(--space-4);
    width: auto;
    height: auto;
    overflow: visible;
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
