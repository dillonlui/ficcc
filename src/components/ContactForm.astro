---
/* ContactForm — form with Cloudflare Turnstile spam protection and
   client-side fetch submission to /api/contact. */
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<form class="contact-form" novalidate aria-busy="false" aria-describedby="contact-privacy-note">
  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-name">Name</label>
    <input
      class="contact-form__input"
      type="text"
      id="contact-name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      autocomplete="name"
      aria-describedby="contact-name-error"
      aria-invalid="false"
      placeholder="Your name"
    />
    <span id="contact-name-error" class="contact-form__error" data-field="name" aria-live="polite" hidden></span>
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-email">Email</label>
    <input
      class="contact-form__input"
      type="email"
      id="contact-email"
      name="email"
      required
      maxlength="254"
      autocomplete="email"
      aria-describedby="contact-email-error"
      aria-invalid="false"
      placeholder="you@example.com"
    />
    <span id="contact-email-error" class="contact-form__error" data-field="email" aria-live="polite" hidden></span>
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-message">Message</label>
    <textarea
      class="contact-form__input contact-form__textarea"
      id="contact-message"
      name="message"
      required
      minlength="10"
      maxlength="5000"
      rows="5"
      aria-describedby="contact-message-error"
      aria-invalid="false"
      placeholder="How can we help?"
    ></textarea>
    <span id="contact-message-error" class="contact-form__error" data-field="message" aria-live="polite" hidden></span>
  </div>

  <!-- Cloudflare Turnstile widget -->
  <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>
  {!siteKey && (
    <p class="contact-form__error" role="status">
      Spam protection is not configured on this deployment, so the form cannot be submitted yet.
      Please email <a href="mailto:info@ficcc.org">info@ficcc.org</a> directly.
    </p>
  )}
  <span id="contact-turnstile-error" class="contact-form__error" data-field="turnstileToken" aria-live="polite" hidden></span>

  <p id="contact-privacy-note" class="contact-form__privacy">
    We use the details you provide to respond to your message. This form is protected by
    Cloudflare Turnstile and delivered through Resend. <a href="/en/privacy">Read our privacy notice</a>.
  </p>

  <button class="contact-form__submit" type="submit">
    <span class="contact-form__submit-text">Send Message</span>
    <span class="contact-form__spinner" aria-hidden="true"></span>
  </button>

  <!-- General error banner -->
  <div class="contact-form__banner contact-form__banner--error" role="alert" tabindex="-1" hidden></div>

  <!-- Success message -->
  <div class="contact-form__banner contact-form__banner--success" role="status" aria-atomic="true" tabindex="-1" hidden></div>
</form>

<script is:inline>
(function () {
  const form = document.querySelector('.contact-form');
  if (!form) return;

  const submitBtn = form.querySelector('.contact-form__submit');
  const submitText = form.querySelector('.contact-form__submit-text');
  const spinner = form.querySelector('.contact-form__spinner');
  const errorBanner = form.querySelector('.contact-form__banner--error');
  const successBanner = form.querySelector('.contact-form__banner--success');

  /* ---- Helpers ---- */

  function showFieldError(field, msg) {
    const el = form.querySelector('[data-field="' + field + '"]');
    if (el) {
      el.textContent = msg;
      el.hidden = false;
    }
    const input = form.querySelector('[name="' + field + '"]');
    if (input) {
      input.classList.add('contact-form__input--error');
      input.setAttribute('aria-invalid', 'true');
    }
  }

  function clearErrors() {
    form.querySelectorAll('.contact-form__error').forEach(function (el) {
      el.textContent = '';
      el.hidden = true;
    });
    form.querySelectorAll('.contact-form__input--error').forEach(function (el) {
      el.classList.remove('contact-form__input--error');
    });
    form.querySelectorAll('[aria-invalid="true"]').forEach(function (el) {
      el.setAttribute('aria-invalid', 'false');
    });
    errorBanner.hidden = true;
    errorBanner.textContent = '';
  }

  function focusFirstInvalidField() {
    var firstInvalid = form.querySelector('[aria-invalid="true"]');
    if (firstInvalid) firstInvalid.focus();
  }

  function showSystemError(message) {
    errorBanner.textContent = message;
    errorBanner.hidden = false;
    errorBanner.focus();
  }

  function resetTurnstile() {
    if (typeof turnstile !== 'undefined') {
      try { turnstile.reset(); } catch (_) {}
    }
  }

  function setLoading(loading) {
    submitBtn.disabled = loading;
    submitText.textContent = loading ? 'Sending…' : 'Send Message';
    spinner.hidden = !loading;
    form.setAttribute('aria-busy', String(loading));
  }

  /* ---- Client-side validation ---- */

  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function validate() {
    var errors = [];
    var name = form.querySelector('[name="name"]').value.trim();
    var email = form.querySelector('[name="email"]').value.trim();
    var message = form.querySelector('[name="message"]').value.trim();

    if (name.length < 2) {
      errors.push({ field: 'name', message: 'Name is required (min 2 characters)' });
    }
    if (!EMAIL_RE.test(email)) {
      errors.push({ field: 'email', message: 'A valid email address is required' });
    }
    if (message.length < 10) {
      errors.push({ field: 'message', message: 'Message is required (min 10 characters)' });
    }
    return errors;
  }

  /* ---- Submission ---- */

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    clearErrors();
    successBanner.hidden = true;

    /* Client-side validation */
    var clientErrors = validate();
    if (clientErrors.length > 0) {
      clientErrors.forEach(function (err) { showFieldError(err.field, err.message); });
      focusFirstInvalidField();
      return;
    }

    /* Get Turnstile token */
    var turnstileInput = form.querySelector('[name="cf-turnstile-response"]');
    var turnstileToken = turnstileInput ? turnstileInput.value : '';
    if (!turnstileToken) {
      var turnstileContainer = form.querySelector('.cf-turnstile');
      var siteKey = turnstileContainer ? (turnstileContainer.getAttribute('data-sitekey') || '') : '';
      showFieldError(
        'turnstileToken',
        siteKey
          ? 'Please complete the captcha verification'
          : 'Spam protection is not configured. Please email info@ficcc.org directly.',
      );
      return;
    }

    setLoading(true);

    var payload = {
      name: form.querySelector('[name="name"]').value.trim(),
      email: form.querySelector('[name="email"]').value.trim(),
      message: form.querySelector('[name="message"]').value.trim(),
      turnstileToken: turnstileToken,
    };

    try {
      var res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      var data = await res.json();

      if (!res.ok) {
        /* Field-level errors from server */
        var hasFieldErrors = data.fields && Array.isArray(data.fields) && data.fields.length > 0;
        if (hasFieldErrors) {
          data.fields.forEach(function (err) { showFieldError(err.field, err.message); });
        }
        resetTurnstile();
        if (hasFieldErrors) focusFirstInvalidField();
        else showSystemError(data.error || 'Something went wrong. Please try again.');
        return;
      }

      /* Success */
      successBanner.textContent = data.message || 'Your message has been sent!';
      successBanner.hidden = false;
      form.reset();
      resetTurnstile();
      successBanner.focus();
    } catch (err) {
      resetTurnstile();
      showSystemError("We couldn't confirm the status of your message. Please wait a moment, then try again or contact us directly.");
    } finally {
      setLoading(false);
    }
  });
})();
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 36rem;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-form__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  .contact-form__input {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-body);
    background-color: var(--color-bg);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .contact-form__input::placeholder {
    color: var(--color-stone);
  }

  .contact-form__input:focus {
    outline: none;
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-focus) 25%, transparent);
  }

  .contact-form__input--error {
    border-color: var(--danger, #B8453A);
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact-form__error {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--danger, #B8453A);
    min-height: 0;
  }

  .contact-form__error:empty,
  .contact-form__error[hidden] {
    display: none;
  }

  .contact-form__submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-bg);
    background-color: var(--primary-500);
    border: none;
    border-radius: 100vw;
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    transition: background-color var(--transition), transform var(--transition), opacity var(--transition);
  }

  .contact-form__privacy {
    max-width: 34rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-body);
  }

  .contact-form__privacy a {
    color: var(--color-terracotta-dark);
    text-underline-offset: 0.18em;
  }

  .contact-form__privacy a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .contact-form__submit:hover:not(:disabled) {
    background-color: var(--primary-400);
    transform: translateY(-1px);
  }

  .contact-form__submit:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .contact-form__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Spinner */
  .contact-form__spinner {
    display: none;
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: contact-spin 0.6s linear infinite;
  }

  .contact-form__submit:disabled .contact-form__spinner {
    display: inline-block;
  }

  @keyframes contact-spin {
    to { transform: rotate(360deg); }
  }

  /* Banners */
  .contact-form__banner {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
  }

  .contact-form__banner[hidden] {
    display: none;
  }

  .contact-form__banner--error {
    color: var(--danger-text);
    background-color: var(--danger-bg);
    border: 1px solid var(--danger-border);
  }

  .contact-form__banner--success {
    color: var(--success-text);
    background-color: var(--success-bg);
    border: 1px solid var(--success-border);
  }
</style>
