---
import HomepageEventCard from './HomepageEventCard.astro';
import type { ActiveEvent } from '../lib/events';

interface Props {
  events: ActiveEvent[];
  lang: 'en' | 'zh';
}

const { events, lang } = Astro.props;
const isZh = lang === 'zh';
const isCarousel = events.length > 3;
const headingId = `events-heading-${lang}`;
const viewportId = `events-viewport-${lang}`;
const heading = isZh ? '近期活動' : 'Coming up at FICCC';
const intro = isZh
  ? '一起敬拜、團契並服事我們的社區。'
  : 'Gather with us for worship, fellowship, and life in our community.';
const carouselLabel = isZh ? '近期活動輪播' : 'Upcoming events carousel';
const previousLabel = isZh ? '查看上一個活動' : 'View previous event';
const nextLabel = isZh ? '查看下一個活動' : 'View next event';
---

{events.length > 0 && (
  <section
    class:list={['events-showcase', { 'events-showcase--carousel': isCarousel }]}
    aria-labelledby={headingId}
    data-events-showcase={isCarousel ? '' : undefined}
    data-lang={lang}
  >
    <div class="events-showcase__texture" aria-hidden="true"></div>
    <div class="events-showcase__inner">
      <div class="events-showcase__header" data-reveal>
        <div>
          <p class="events-showcase__eyebrow">{isZh ? '歡迎參加' : 'You’re invited'}</p>
          <h2 id={headingId}>{heading}</h2>
          <p class="events-showcase__intro">{intro}</p>
        </div>

        {isCarousel && (
          <div class="events-showcase__controls" aria-label={carouselLabel}>
            <p class="events-showcase__position" aria-live="polite" aria-atomic="true">
              {isZh ? `第 1–3 項，共 ${events.length} 項` : `1–3 of ${events.length}`}
            </p>
            <button type="button" data-events-previous aria-controls={viewportId} aria-label={previousLabel}>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
            </button>
            <button type="button" data-events-next aria-controls={viewportId} aria-label={nextLabel}>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </button>
          </div>
        )}
      </div>

      {events.length === 1 ? (
        <div class="events-showcase__feature" data-reveal>
          <HomepageEventCard event={events[0]} lang={lang} variant="feature" />
        </div>
      ) : isCarousel ? (
        <div
          id={viewportId}
          class="events-showcase__viewport"
          role="region"
          aria-roledescription="carousel"
          aria-label={carouselLabel}
          tabindex="0"
          data-events-viewport
        >
          <ol class="events-showcase__track" data-events-track>
            {events.map((event, index) => (
              <li
                class="events-showcase__slide"
                aria-roledescription={isZh ? '投影片' : 'slide'}
                aria-label={isZh ? `第 ${index + 1} 項，共 ${events.length} 項` : `${index + 1} of ${events.length}`}
                data-events-slide
              >
                <HomepageEventCard event={event} lang={lang} eager={index < 3} />
              </li>
            ))}
          </ol>
        </div>
      ) : (
        <div class="events-showcase__grid" data-reveal-stagger>
          {events.map((event) => (
            <div data-reveal><HomepageEventCard event={event} lang={lang} /></div>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .events-showcase {
    background: var(--base-100);
    overflow: hidden;
    padding: var(--space-20) var(--space-6);
    position: relative;
  }

  .events-showcase__texture {
    background-image: url('/images/textures/kiwihug-qv05FvdE26k-unsplash.jpg');
    background-position: center;
    background-size: cover;
    inset: 0;
    mix-blend-mode: multiply;
    opacity: 0.06;
    pointer-events: none;
    position: absolute;
  }

  .events-showcase__inner {
    margin-inline: auto;
    max-width: var(--max-width);
    position: relative;
  }

  .events-showcase__header {
    align-items: end;
    display: flex;
    gap: var(--space-8);
    justify-content: space-between;
    margin-block-end: var(--space-10);
  }

  .events-showcase__eyebrow {
    color: var(--color-terracotta-dark);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-block-end: var(--space-2);
    text-transform: uppercase;
  }

  .events-showcase h2 {
    font-size: var(--text-3xl);
  }

  .events-showcase__intro {
    color: var(--color-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin-block-start: var(--space-3);
    max-width: 42rem;
  }

  .events-showcase__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .events-showcase__grid > div {
    min-width: 0;
  }

  .events-showcase__controls {
    align-items: center;
    display: none;
    flex-shrink: 0;
    gap: var(--space-2);
  }

  .events-showcase.is-enhanced .events-showcase__controls {
    display: flex;
  }

  .events-showcase__position {
    color: var(--color-body);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    margin-inline-end: var(--space-2);
    min-width: 6rem;
    text-align: end;
  }

  .events-showcase__controls button {
    align-items: center;
    background: var(--base-50);
    border: 1px solid var(--base-400);
    border-radius: 50%;
    color: var(--primary-700);
    cursor: pointer;
    display: inline-flex;
    height: var(--space-12);
    justify-content: center;
    transition: background var(--transition), color var(--transition), opacity var(--transition);
    width: var(--space-12);
  }

  .events-showcase__controls button:hover:not(:disabled) {
    background: var(--primary-600);
    color: var(--base-50);
  }

  .events-showcase__controls button:focus-visible,
  .events-showcase__viewport:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: var(--space-1);
  }

  .events-showcase__controls button:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .events-showcase__controls svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: var(--space-5);
  }

  .events-showcase__viewport {
    margin-inline: calc(var(--space-1) * -1);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: var(--space-1);
    scrollbar-color: var(--primary-400) var(--base-200);
    scrollbar-width: thin;
    scroll-snap-type: inline mandatory;
  }

  .events-showcase__track {
    display: grid;
    gap: var(--space-6);
    grid-auto-columns: calc((100% - (var(--space-6) * 2)) / 3);
    grid-auto-flow: column;
    list-style: none;
  }

  .events-showcase__slide {
    min-width: 0;
    scroll-snap-align: start;
  }

  @media (max-width: 920px) {
    .events-showcase__track {
      grid-auto-columns: calc((100% - var(--space-6)) / 2);
    }
  }

  @media (max-width: 640px) {
    .events-showcase {
      padding: var(--space-16) var(--space-5);
    }

    .events-showcase__header {
      align-items: start;
      flex-direction: column;
      margin-block-end: var(--space-8);
    }

    .events-showcase h2 {
      font-size: var(--text-2xl);
    }

    .events-showcase__intro {
      font-size: var(--text-base);
    }

    .events-showcase__controls {
      align-self: stretch;
      justify-content: flex-end;
    }

    .events-showcase__position {
      margin-inline-end: auto;
      text-align: start;
    }

    .events-showcase__track {
      gap: var(--space-4);
      grid-auto-columns: 88%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .events-showcase__viewport {
      scroll-behavior: auto;
    }

    .events-showcase__controls button {
      transition: none;
    }
  }
</style>

{isCarousel && (
  <script>
    document.querySelectorAll<HTMLElement>('[data-events-showcase]').forEach((showcase) => {
      const viewport = showcase.querySelector<HTMLElement>('[data-events-viewport]');
      const slides = Array.from(showcase.querySelectorAll<HTMLElement>('[data-events-slide]'));
      const previous = showcase.querySelector<HTMLButtonElement>('[data-events-previous]');
      const next = showcase.querySelector<HTMLButtonElement>('[data-events-next]');
      const position = showcase.querySelector<HTMLElement>('.events-showcase__position');
      const lang = showcase.dataset.lang === 'zh' ? 'zh' : 'en';
      if (!viewport || !slides.length || !previous || !next || !position) return;

      showcase.classList.add('is-enhanced');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeIndex = 0;
      let frame = 0;

      const visibleCount = () => {
        const slideWidth = slides[0]?.getBoundingClientRect().width || viewport.clientWidth;
        return Math.max(1, Math.min(slides.length, Math.round(viewport.clientWidth / slideWidth)));
      };

      const update = () => {
        const viewportLeft = viewport.getBoundingClientRect().left;
        activeIndex = slides.reduce((closest, slide, index) => {
          const currentDistance = Math.abs(slides[closest].getBoundingClientRect().left - viewportLeft);
          const distance = Math.abs(slide.getBoundingClientRect().left - viewportLeft);
          return distance < currentDistance ? index : closest;
        }, 0);

        const count = visibleCount();
        const lastVisible = Math.min(slides.length, activeIndex + count);
        position.textContent = lang === 'zh'
          ? `第 ${activeIndex + 1}–${lastVisible} 項，共 ${slides.length} 項`
          : `${activeIndex + 1}–${lastVisible} of ${slides.length}`;
        previous.disabled = activeIndex === 0;
        next.disabled = lastVisible >= slides.length;
      };

      const goTo = (index: number) => {
        const target = slides[Math.max(0, Math.min(slides.length - 1, index))];
        viewport.scrollTo({
          left: target.offsetLeft - slides[0].offsetLeft,
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      };

      previous.addEventListener('click', () => goTo(activeIndex - 1));
      next.addEventListener('click', () => goTo(activeIndex + 1));
      viewport.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        goTo(activeIndex + (event.key === 'ArrowRight' ? 1 : -1));
      });
      viewport.addEventListener('scroll', () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      }, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    });
  </script>
)}
