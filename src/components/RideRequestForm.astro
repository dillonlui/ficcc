---
/* RideRequestForm — ride request form with Cloudflare Turnstile spam
   protection and client-side fetch submission to /api/ride-request.
   Adapted from ContactForm pattern. */
interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const t = lang === 'zh' ? {
  name: '姓名 Name',
  email: '電郵 Email',
  phone: '電話 Phone',
  date: '希望日期 Preferred Date',
  pickup: '接送地點 Pickup Location',
  notes: '備註 Notes',
  namePlaceholder: '您的姓名',
  emailPlaceholder: 'you@example.com',
  phonePlaceholder: '（選填）',
  pickupPlaceholder: '例如：宿舍名稱或街道地址',
  notesPlaceholder: '其他需要我們知道的事情？（選填）',
  submit: '申請接送',
  captcha: '請完成驗證',
  privacy: '我們只會使用您提供的資料來安排接送。此表單由 Cloudflare Turnstile 保護，並透過 Resend 傳送。',
  privacyLink: '閱讀隱私聲明',
} : {
  name: 'Name',
  email: 'Email',
  phone: 'Phone',
  date: 'Preferred Date',
  pickup: 'Pickup Location',
  notes: 'Notes',
  namePlaceholder: 'Your name',
  emailPlaceholder: 'you@example.com',
  phonePlaceholder: '(optional)',
  pickupPlaceholder: 'e.g. campus dorm name or street address',
  notesPlaceholder: 'Anything else we should know? (optional)',
  submit: 'Request a Ride',
  captcha: 'Please complete the captcha verification',
  privacy: 'We use the details you provide to coordinate your ride. This form is protected by Cloudflare Turnstile and delivered through Resend.',
  privacyLink: 'Read our privacy notice',
};
---

<form class="ride-form" novalidate aria-busy="false" lang={lang} aria-describedby="ride-privacy-note">
  <div class="ride-form__row">
    <div class="ride-form__field">
      <label class="ride-form__label" for="ride-name">{t.name} <span aria-hidden="true">*</span></label>
      <input
        class="ride-form__input"
        type="text"
        id="ride-name"
        name="name"
        required
        minlength="2"
        maxlength="100"
        autocomplete="name"
        aria-describedby="ride-name-error"
        aria-invalid="false"
        placeholder={t.namePlaceholder}
      />
      <span id="ride-name-error" class="ride-form__error" data-field="name" aria-live="polite" hidden></span>
    </div>

    <div class="ride-form__field">
      <label class="ride-form__label" for="ride-email">{t.email} <span aria-hidden="true">*</span></label>
      <input
        class="ride-form__input"
        type="email"
        id="ride-email"
        name="email"
        required
        maxlength="254"
        autocomplete="email"
        aria-describedby="ride-email-error"
        aria-invalid="false"
        placeholder={t.emailPlaceholder}
      />
      <span id="ride-email-error" class="ride-form__error" data-field="email" aria-live="polite" hidden></span>
    </div>
  </div>

  <div class="ride-form__row">
    <div class="ride-form__field">
      <label class="ride-form__label" for="ride-phone">{t.phone}</label>
      <input
        class="ride-form__input"
        type="tel"
        id="ride-phone"
        name="phone"
        minlength="7"
        maxlength="40"
        autocomplete="tel"
        aria-describedby="ride-phone-error"
        aria-invalid="false"
        placeholder={t.phonePlaceholder}
      />
      <span id="ride-phone-error" class="ride-form__error" data-field="phone" aria-live="polite" hidden></span>
    </div>

    <div class="ride-form__field">
      <label class="ride-form__label" for="ride-date">{t.date}</label>
      <input
        class="ride-form__input"
        type="date"
        id="ride-date"
        name="preferredDate"
        aria-describedby="ride-date-error"
        aria-invalid="false"
      />
      <span id="ride-date-error" class="ride-form__error" data-field="preferredDate" aria-live="polite" hidden></span>
    </div>
  </div>

  <div class="ride-form__field">
    <label class="ride-form__label" for="ride-pickup">{t.pickup} <span aria-hidden="true">*</span></label>
    <input
      class="ride-form__input"
      type="text"
      id="ride-pickup"
      name="pickupLocation"
        required
        minlength="5"
        maxlength="300"
        aria-describedby="ride-pickup-error"
        aria-invalid="false"
        placeholder={t.pickupPlaceholder}
      />
    <span id="ride-pickup-error" class="ride-form__error" data-field="pickupLocation" aria-live="polite" hidden></span>
  </div>

  <div class="ride-form__field">
    <label class="ride-form__label" for="ride-notes">{t.notes}</label>
    <textarea
      class="ride-form__input ride-form__textarea"
      id="ride-notes"
      name="notes"
      rows="3"
      maxlength="2000"
      aria-describedby="ride-notes-error"
      aria-invalid="false"
      placeholder={t.notesPlaceholder}
    ></textarea>
    <span id="ride-notes-error" class="ride-form__error" data-field="notes" aria-live="polite" hidden></span>
  </div>

  <!-- Cloudflare Turnstile widget -->
  <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>
  {!siteKey && (
    <p class="ride-form__error" role="status">
      {lang === 'zh'
        ? '目前無法載入表單驗證，請改以電郵聯絡我們：'
        : 'Spam protection is not configured on this deployment, so the form cannot be submitted yet. Please email '}
      <a href="mailto:info@ficcc.org">info@ficcc.org</a>
      {lang === 'zh' ? '。' : ' directly.'}
    </p>
  )}
  <span id="ride-turnstile-error" class="ride-form__error" data-field="turnstileToken" aria-live="polite" hidden></span>

  <p id="ride-privacy-note" class="ride-form__privacy">
    {t.privacy} <a href={lang === 'zh' ? '/zh/privacy' : '/en/privacy'}>{t.privacyLink}</a>.
  </p>

  <button class="ride-form__submit" type="submit">
    <span class="ride-form__submit-text">{t.submit}</span>
    <span class="ride-form__spinner" aria-hidden="true"></span>
  </button>

  <!-- General error banner -->
  <div class="ride-form__banner ride-form__banner--error" role="alert" tabindex="-1" hidden></div>

  <!-- Success message -->
  <div class="ride-form__banner ride-form__banner--success" role="status" aria-atomic="true" tabindex="-1" hidden></div>
</form>

<script is:inline>
(function () {
  const form = document.querySelector('.ride-form');
  if (!form) return;

  const submitBtn = form.querySelector('.ride-form__submit');
  const submitText = form.querySelector('.ride-form__submit-text');
  const spinner = form.querySelector('.ride-form__spinner');
  const errorBanner = form.querySelector('.ride-form__banner--error');
  const successBanner = form.querySelector('.ride-form__banner--success');
  const copy = form.getAttribute('lang') === 'zh'
    ? {
      submit: '申請接送',
      sending: '發送中…',
      nameError: '請輸入您的姓名（至少2個字）',
      emailError: '請輸入有效的電郵地址',
      pickupError: '請輸入接送地點（至少5個字）',
      captchaError: '請完成驗證',
      captchaMissing: '目前無法載入表單驗證，請改以電郵聯絡我們：info@ficcc.org',
      captchaFailure: '驗證失敗，請再試一次。',
      unavailable: '表單目前暫時無法使用，請稍後再試。',
      requestFailed: '目前無法提交申請，請稍後再試。',
      success: '您的接送申請已送出！我們會盡快與您聯絡。',
      uncertain: '我們無法確認申請是否已送出。請稍候再試，或直接聯絡我們。',
    }
    : {
      submit: 'Request a Ride',
      sending: 'Sending…',
      nameError: 'Name is required (min 2 characters)',
      emailError: 'A valid email address is required',
      pickupError: 'Pickup location is required (min 5 characters)',
      captchaError: 'Please complete the captcha verification',
      captchaMissing: 'Spam protection is not configured. Please email info@ficcc.org directly.',
      captchaFailure: 'Captcha verification failed. Please try again.',
      unavailable: 'This form is temporarily unavailable. Please try again later.',
      requestFailed: 'Unable to submit your ride request right now. Please try again later.',
      success: 'Your ride request has been submitted! We’ll be in touch soon.',
      uncertain: "We couldn't confirm the status of your request. Please wait a moment, then try again or contact us directly.",
    };

  /* ---- Helpers ---- */

  function showFieldError(field, msg) {
    var el = form.querySelector('[data-field="' + field + '"]');
    if (el) {
      el.textContent = msg;
      el.hidden = false;
    }
    var input = form.querySelector('[name="' + field + '"]');
    if (input) {
      input.classList.add('ride-form__input--error');
      input.setAttribute('aria-invalid', 'true');
    }
  }

  function clearErrors() {
    form.querySelectorAll('.ride-form__error').forEach(function (el) {
      el.textContent = '';
      el.hidden = true;
    });
    form.querySelectorAll('.ride-form__input--error').forEach(function (el) {
      el.classList.remove('ride-form__input--error');
    });
    form.querySelectorAll('[aria-invalid="true"]').forEach(function (el) {
      el.setAttribute('aria-invalid', 'false');
    });
    errorBanner.hidden = true;
    errorBanner.textContent = '';
  }

  function focusFirstInvalidField() {
    var firstInvalid = form.querySelector('[aria-invalid="true"]');
    if (firstInvalid) firstInvalid.focus();
  }

  function showSystemError(message) {
    errorBanner.textContent = message;
    errorBanner.hidden = false;
    errorBanner.focus();
  }

  function resetTurnstile() {
    if (typeof turnstile !== 'undefined') {
      try { turnstile.reset(); } catch (_) {}
    }
  }

  function responseMessage(status, message) {
    if (form.getAttribute('lang') !== 'zh') return message || copy.requestFailed;
    if (status === 403) return copy.captchaFailure;
    if (status === 503) return copy.unavailable;
    return copy.requestFailed;
  }

  function setLoading(loading) {
    submitBtn.disabled = loading;
    submitText.textContent = loading ? copy.sending : copy.submit;
    spinner.hidden = !loading;
    form.setAttribute('aria-busy', String(loading));
  }

  /* ---- Client-side validation ---- */

  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function validate() {
    var errors = [];
    var name = form.querySelector('[name="name"]').value.trim();
    var email = form.querySelector('[name="email"]').value.trim();
    var pickup = form.querySelector('[name="pickupLocation"]').value.trim();

    if (name.length < 2) {
      errors.push({ field: 'name', message: copy.nameError });
    }
    if (!EMAIL_RE.test(email)) {
      errors.push({ field: 'email', message: copy.emailError });
    }
    if (pickup.length < 5) {
      errors.push({ field: 'pickupLocation', message: copy.pickupError });
    }
    return errors;
  }

  /* ---- Submission ---- */

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    clearErrors();
    successBanner.hidden = true;

    /* Client-side validation */
    var clientErrors = validate();
    if (clientErrors.length > 0) {
      clientErrors.forEach(function (err) { showFieldError(err.field, err.message); });
      focusFirstInvalidField();
      return;
    }

    /* Get Turnstile token */
    var turnstileInput = form.querySelector('[name="cf-turnstile-response"]');
    var turnstileToken = turnstileInput ? turnstileInput.value : '';
    if (!turnstileToken) {
      var turnstileContainer = form.querySelector('.cf-turnstile');
      var siteKey = turnstileContainer ? (turnstileContainer.getAttribute('data-sitekey') || '') : '';
      showFieldError('turnstileToken', siteKey ? copy.captchaError : copy.captchaMissing);
      return;
    }

    setLoading(true);

    var payload = {
      name: form.querySelector('[name="name"]').value.trim(),
      email: form.querySelector('[name="email"]').value.trim(),
      phone: form.querySelector('[name="phone"]').value.trim(),
      pickupLocation: form.querySelector('[name="pickupLocation"]').value.trim(),
      preferredDate: form.querySelector('[name="preferredDate"]').value,
      notes: form.querySelector('[name="notes"]').value.trim(),
      turnstileToken: turnstileToken,
    };

    try {
      var res = await fetch('/api/ride-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      var data = await res.json();

      if (!res.ok) {
        /* Field-level errors from server */
        var hasFieldErrors = data.fields && Array.isArray(data.fields) && data.fields.length > 0;
        if (hasFieldErrors) {
          data.fields.forEach(function (err) { showFieldError(err.field, err.message); });
        }
        resetTurnstile();
        if (hasFieldErrors) focusFirstInvalidField();
        else showSystemError(responseMessage(res.status, data.error));
        return;
      }

      /* Success */
      successBanner.textContent = form.getAttribute('lang') === 'zh'
        ? copy.success
        : (data.message || copy.success);
      successBanner.hidden = false;
      form.reset();
      resetTurnstile();
      successBanner.focus();
    } catch (err) {
      resetTurnstile();
      showSystemError(copy.uncertain);
    } finally {
      setLoading(false);
    }
  });
})();
</script>

<style>
  .ride-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 36rem;
    margin-inline: auto;
  }

  .ride-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .ride-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ride-form__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--base-200);
  }

  .ride-form__label span {
    color: var(--danger, #B8453A);
  }

  .ride-form__input {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink);
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--base-400);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .ride-form__input::placeholder {
    color: var(--color-stone);
  }

  .ride-form__input:focus {
    outline: none;
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-focus) 25%, transparent);
  }

  .ride-form__input--error {
    border-color: var(--danger, #B8453A);
  }

  .ride-form__textarea {
    resize: vertical;
    min-height: 5rem;
  }

  .ride-form__error {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--danger, #B8453A);
    min-height: 0;
  }

  .ride-form__error:empty,
  .ride-form__error[hidden] {
    display: none;
  }

  .ride-form__submit {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--base-50);
    background-color: var(--primary-500);
    border: none;
    border-radius: 100vw;
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    transition: background-color var(--transition), transform var(--transition), opacity var(--transition);
  }

  .ride-form__privacy {
    max-width: 34rem;
    margin-inline: auto;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--base-200);
  }

  .ride-form__privacy a {
    color: var(--base-50);
    text-underline-offset: 0.18em;
  }

  .ride-form__privacy a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .ride-form__submit:hover:not(:disabled) {
    background-color: var(--primary-600);
    transform: translateY(-1px);
  }

  .ride-form__submit:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .ride-form__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Spinner */
  .ride-form__spinner {
    display: none;
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: ride-spin 0.6s linear infinite;
  }

  .ride-form__submit:disabled .ride-form__spinner {
    display: inline-block;
  }

  @keyframes ride-spin {
    to { transform: rotate(360deg); }
  }

  /* Banners */
  .ride-form__banner {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
  }

  .ride-form__banner[hidden] {
    display: none;
  }

  .ride-form__banner--error {
    color: var(--danger-text);
    background-color: var(--danger-bg);
    border: 1px solid var(--danger-border);
  }

  .ride-form__banner--success {
    color: var(--success-text);
    background-color: var(--success-bg);
    border: 1px solid var(--success-border);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .ride-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
