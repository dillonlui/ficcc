---
import { formatEventDate, getRecurrenceLabel, type ActiveEvent } from '../lib/events';
import { urlForImage } from '../lib/sanity';

interface Props {
  event: ActiveEvent;
  lang: 'en' | 'zh';
  variant?: 'card' | 'feature';
  eager?: boolean;
}

const { event, lang, variant = 'card', eager = false } = Astro.props;
const isZh = lang === 'zh';
const image = event.image ? urlForImage(event.image, { width: variant === 'feature' ? 1200 : 720 }) : undefined;
const date = new Date(`${event.nextOccurrenceDate}T12:00:00Z`);
const locale = isZh ? 'zh-TW' : 'en-US';
const month = new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' }).format(date);
const day = new Intl.DateTimeFormat(locale, { day: 'numeric', timeZone: 'UTC' }).format(date);
const fullDate = formatEventDate(event.nextOccurrenceDate, lang);
const recurrence = getRecurrenceLabel(event, lang);
const status = event.isRecurring
  ? (isZh ? '定期活動' : 'Recurring')
  : event.isOngoing
    ? (isZh ? '進行中' : 'Happening now')
    : (isZh ? '即將舉行' : 'Coming up');
const href = `/${lang}/events/${event.slug?.current}`;
const detailsText = isZh ? '查看活動詳情' : 'View event details';
---

<article class:list={['home-event-card', `home-event-card--${variant}`, { 'home-event-card--no-image': !image }]}>
  <a class="home-event-card__link" href={href} aria-label={`${event.title} — ${detailsText}`}>
    <div class="home-event-card__media">
      {image ? (
        <img
          src={image}
          alt={event.imageAlt || ''}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="home-event-card__pattern" aria-hidden="true">
          <svg viewBox="0 0 600 400" preserveAspectRatio="none">
            <path d="M0 270C105 210 190 315 305 252S493 205 600 278V400H0Z"></path>
            <path d="M0 315C132 265 212 365 346 294S520 270 600 324V400H0Z"></path>
          </svg>
        </div>
      )}
      <div class="home-event-card__date" aria-hidden="true">
        <span>{month}</span>
        <strong>{day}</strong>
      </div>
    </div>

    <div class="home-event-card__content">
      <p class="home-event-card__status">{status}</p>
      <h3>{event.title}</h3>
      {event.summary && <p class="home-event-card__summary">{event.summary}</p>}
      <div class="home-event-card__meta">
        <p>
          <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
          <span>{recurrence || fullDate}</span>
        </p>
        {event.time && (
          <p>
            <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            <span>{event.time}</span>
          </p>
        )}
        {event.location && (
          <p>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1116 0z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            <span>{event.location}</span>
          </p>
        )}
      </div>
      <span class="home-event-card__action">
        {detailsText}
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </span>
    </div>
  </a>
</article>

<style>
  .home-event-card {
    height: 100%;
    min-width: 0;
  }

  .home-event-card__link {
    background: var(--base-50);
    border: 1px solid var(--base-300);
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
    transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
  }

  .home-event-card__link:hover {
    border-color: var(--primary-300);
    box-shadow: 0 var(--space-3) var(--space-8) color-mix(in srgb, var(--primary-900) 14%, transparent);
    transform: translateY(calc(var(--space-1) * -1));
  }

  .home-event-card__link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: var(--space-1);
  }

  .home-event-card__media {
    aspect-ratio: 16 / 10;
    background: var(--primary-700);
    overflow: hidden;
    position: relative;
  }

  .home-event-card__media img {
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
    width: 100%;
  }

  .home-event-card__link:hover .home-event-card__media img {
    transform: scale(1.025);
  }

  .home-event-card__pattern {
    background: linear-gradient(145deg, var(--primary-600), var(--primary-800));
    height: 100%;
    position: relative;
  }

  .home-event-card__pattern::before {
    background-image: url('/images/textures/kiwihug-qv05FvdE26k-unsplash.jpg');
    background-size: cover;
    content: '';
    inset: 0;
    mix-blend-mode: soft-light;
    opacity: 0.22;
    position: absolute;
  }

  .home-event-card__pattern svg {
    bottom: 0;
    height: 78%;
    position: absolute;
    width: 100%;
  }

  .home-event-card__pattern path:first-child {
    fill: var(--primary-500);
  }

  .home-event-card__pattern path:last-child {
    fill: var(--primary-400);
    opacity: 0.75;
  }

  .home-event-card__date {
    align-items: center;
    background: var(--base-50);
    bottom: var(--space-4);
    color: var(--primary-700);
    display: flex;
    flex-direction: column;
    justify-content: center;
    left: var(--space-4);
    min-height: var(--space-16);
    min-width: var(--space-16);
    padding: var(--space-2);
    position: absolute;
  }

  .home-event-card__date span {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-event-card__date strong {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .home-event-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-6);
  }

  .home-event-card__status {
    color: var(--color-terracotta-dark);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-block-end: var(--space-3);
    text-transform: uppercase;
  }

  .home-event-card h3 {
    font-size: var(--text-xl);
  }

  .home-event-card__summary {
    color: var(--color-body);
    line-height: var(--leading-relaxed);
    margin-block-start: var(--space-3);
  }

  .home-event-card__meta {
    border-block-start: 1px solid var(--base-200);
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
  }

  .home-event-card__meta p {
    align-items: start;
    color: var(--color-body);
    display: grid;
    font-size: var(--text-sm);
    gap: var(--space-2);
    grid-template-columns: var(--space-4) 1fr;
  }

  .home-event-card__meta svg,
  .home-event-card__action svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .home-event-card__action {
    align-items: center;
    color: var(--color-terracotta-dark);
    display: flex;
    font-size: var(--text-sm);
    font-weight: 800;
    gap: var(--space-2);
    margin-block-start: auto;
    padding-block-start: var(--space-6);
  }

  .home-event-card__action svg {
    transition: transform var(--transition);
    width: var(--space-5);
  }

  .home-event-card__link:hover .home-event-card__action svg {
    transform: translateX(var(--space-1));
  }

  .home-event-card--feature .home-event-card__link {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
  }

  .home-event-card--feature .home-event-card__media {
    aspect-ratio: auto;
    min-height: 28rem;
  }

  .home-event-card--feature .home-event-card__content {
    justify-content: center;
    padding: var(--space-12);
  }

  .home-event-card--feature h3 {
    font-size: var(--text-3xl);
  }

  .home-event-card--feature .home-event-card__summary {
    font-size: var(--text-lg);
  }

  @media (max-width: 720px) {
    .home-event-card--feature .home-event-card__link {
      display: flex;
    }

    .home-event-card--feature .home-event-card__media {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }

    .home-event-card--feature .home-event-card__content {
      padding: var(--space-6);
    }

    .home-event-card--feature h3 {
      font-size: var(--text-2xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-event-card__link,
    .home-event-card__media img,
    .home-event-card__action svg {
      transition: none;
    }

    .home-event-card__link:hover,
    .home-event-card__link:hover .home-event-card__media img {
      transform: none;
    }
  }
</style>
