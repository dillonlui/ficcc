---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  formatEventDate,
  getEventCalendarDate,
  getEventOccurrence,
  getRecurrenceLabel,
} from '../lib/events';
import { portableTextToHtml, urlForImage, type Event } from '../lib/sanity';
import { buildEventJsonLd } from '../lib/structured-data';

interface Props {
  event: Event;
  lang: 'en' | 'zh';
}

const { event, lang } = Astro.props;
const isZh = lang === 'zh';
const occurrence = getEventOccurrence(event);
const ended = !occurrence;
const startKey = occurrence?.nextOccurrenceDate || getEventCalendarDate(event.date) || '';
const endKey = !occurrence?.isRecurring ? getEventCalendarDate(event.endDate) : null;
const recurrenceLabel = getRecurrenceLabel(event, lang);
const bodyHtml = portableTextToHtml(event.description);
const image = event.image ? urlForImage(event.image, { width: 1800 }) : undefined;
const eventPath = `/${lang}/events/${event.slug?.current}`;
const eventUrl = new URL(eventPath, Astro.site ?? 'https://ficcc.org').href;
const alternatePath = event.translation?.slug && event.translation.language
  ? `/${event.translation.language}/events/${event.translation.slug}`
  : undefined;

const formattedStart = startKey ? formatEventDate(startKey, lang) : '';
const formattedEnd = endKey && endKey !== startKey ? formatEventDate(endKey, lang) : '';
const dateText = recurrenceLabel || [formattedStart, formattedEnd].filter(Boolean).join(isZh ? ' 至 ' : ' – ');
const summary = event.summary || (isZh
  ? '查看活動日期、地點與參加資訊。'
  : 'Find the date, location, and details for this event.');
const statusText = ended
  ? (isZh ? '此活動已結束' : 'This event has ended')
  : occurrence?.isRecurring
    ? (isZh ? '定期活動' : 'Recurring event')
    : occurrence?.isOngoing
      ? (isZh ? '活動進行中' : 'Happening now')
      : (isZh ? '即將舉行' : 'Upcoming event');
const backText = isZh ? '← 返回首頁' : '← Back to home';
const detailsHeading = isZh ? '活動資訊' : 'Event information';
const aboutHeading = isZh ? '活動詳情' : 'About this event';
const dateLabel = isZh ? '日期' : 'Date';
const timeLabel = isZh ? '時間' : 'Time';
const locationLabel = isZh ? '地點' : 'Location';
const contactLabel = isZh ? '聯絡人' : 'Contact';
const mapText = isZh ? '查看地圖' : 'View map';

const jsonLd = buildEventJsonLd({
  title: event.title,
  date: startKey || event.date,
  endDate: endKey || undefined,
  location: event.location,
  address: event.address,
  description: event.summary,
  image,
  url: eventUrl,
  ended,
});
---

<BaseLayout
  title={`${event.title} | ${isZh ? '伊的家華人基督教會' : 'First Ithaca Chinese Christian Church'}`}
  description={summary}
  lang={lang}
  jsonLd={jsonLd}
  ogImage={image}
  ogType="website"
  noindex={ended}
  alternatePath={alternatePath}
>
  <main id="main-content" data-pagefind-body>
    <article class:list={['event-detail', { 'event-detail--ended': ended }]}>
      <header class:list={['event-hero', { 'event-hero--image': image }]}>
        {image && <img class="event-hero__image" src={image} alt={event.imageAlt || ''} fetchpriority="high" />}
        <div class="event-hero__veil"></div>
        <div class="event-hero__inner">
          <a class="event-hero__back" href={`/${lang}/`}>{backText}</a>
          <div class="event-hero__content" data-reveal>
            <p class="event-hero__status">{statusText}</p>
            <h1>{event.title}</h1>
            {event.summary && <p class="event-hero__summary">{event.summary}</p>}
            {dateText && <p class="event-hero__date">{dateText}</p>}
          </div>
        </div>
      </header>

      <div class="event-detail__body">
        {ended && (
          <aside class="event-ended" aria-label={statusText}>
            <strong>{statusText}</strong>
            <span>{isZh ? '以下資料保留供曾收到此連結的訪客參考。' : 'The details remain available for people who previously received this link.'}</span>
          </aside>
        )}

        <div class:list={['event-detail__layout', { 'event-detail__layout--facts-only': !bodyHtml }]}>
          <section class="event-facts" aria-labelledby="event-facts-heading">
            <p class="event-facts__eyebrow">{detailsHeading}</p>
            <h2 id="event-facts-heading" class="sr-only">{detailsHeading}</h2>

            {dateText && (
              <div class="event-fact">
                <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
                <div><span>{dateLabel}</span><strong>{dateText}</strong></div>
              </div>
            )}
            {event.time && (
              <div class="event-fact">
                <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                <div><span>{timeLabel}</span><strong>{event.time}</strong></div>
              </div>
            )}
            {(event.location || event.address) && (
              <div class="event-fact">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1116 0z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                <div>
                  <span>{locationLabel}</span>
                  {event.location && <strong>{event.location}</strong>}
                  {event.address && <p>{event.address}</p>}
                  {event.mapUrl && <a href={event.mapUrl}>{mapText} →</a>}
                </div>
              </div>
            )}
            {(event.contactName || event.contactEmail) && (
              <div class="event-fact">
                <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0116 0"></path></svg>
                <div>
                  <span>{contactLabel}</span>
                  {event.contactName && <strong>{event.contactName}</strong>}
                  {event.contactEmail && <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a>}
                </div>
              </div>
            )}

            {!ended && event.registrationLabel && event.registrationUrl && (
              <a class="event-facts__cta" href={event.registrationUrl}>
                {event.registrationLabel}
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
            )}
          </section>

          {bodyHtml && (
            <section class="event-copy" aria-labelledby="event-about-heading" data-reveal>
              <p class="event-copy__eyebrow">{isZh ? '歡迎參加' : 'You’re invited'}</p>
              <h2 id="event-about-heading">{aboutHeading}</h2>
              <div class="event-copy__rich" set:html={bodyHtml} />
            </section>
          )}
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .event-detail {
    background: var(--color-bg);
  }

  .event-hero {
    background:
      radial-gradient(circle at 78% 22%, var(--primary-500) 0, transparent 32%),
      linear-gradient(135deg, var(--primary-800), var(--primary-600));
    color: var(--base-50);
    min-height: 38rem;
    overflow: hidden;
    position: relative;
  }

  .event-hero::after {
    background-image: url("/images/textures/kiwihug-qv05FvdE26k-unsplash.jpg");
    background-position: center;
    background-size: cover;
    content: '';
    inset: 0;
    mix-blend-mode: soft-light;
    opacity: 0.18;
    pointer-events: none;
    position: absolute;
  }

  .event-hero__image,
  .event-hero__veil {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  .event-hero__image {
    object-fit: cover;
  }

  .event-hero__veil {
    background: linear-gradient(90deg, color-mix(in srgb, var(--primary-900) 92%, transparent) 0%, color-mix(in srgb, var(--primary-900) 64%, transparent) 52%, color-mix(in srgb, var(--primary-900) 18%, transparent) 100%);
  }

  .event-hero__inner {
    display: flex;
    flex-direction: column;
    margin-inline: auto;
    min-height: 38rem;
    max-width: var(--max-width);
    padding: var(--space-10) var(--space-6) var(--space-16);
    position: relative;
    z-index: 1;
  }

  .event-hero__back {
    align-self: flex-start;
    color: var(--base-50);
    font-family: var(--font-body);
    font-weight: 700;
    text-decoration: none;
  }

  .event-hero__back:hover {
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }

  .event-hero__back:focus-visible,
  .event-facts a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: var(--space-1);
  }

  .event-hero__content {
    margin-block: auto;
    max-width: 48rem;
    padding-block-start: var(--space-16);
  }

  .event-hero__status,
  .event-facts__eyebrow,
  .event-copy__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .event-hero__status {
    color: var(--secondary-200);
    margin-block-end: var(--space-4);
  }

  .event-hero h1 {
    color: var(--base-50);
    font-size: clamp(var(--text-3xl), 7vw, 4.75rem);
    line-height: 1.04;
    max-width: 12ch;
  }

  .event-hero__summary {
    color: var(--base-100);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    margin-block-start: var(--space-6);
    max-width: 42rem;
  }

  .event-hero__date {
    border-inline-start: var(--space-1) solid var(--secondary-300);
    color: var(--base-50);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    margin-block-start: var(--space-8);
    padding-inline-start: var(--space-4);
  }

  .event-detail--ended .event-hero__image {
    filter: saturate(0.45);
  }

  .event-detail__body {
    margin-inline: auto;
    max-width: var(--max-width);
    padding: var(--space-16) var(--space-6) var(--space-24);
  }

  .event-ended {
    align-items: center;
    background: var(--secondary-50);
    border-inline-start: var(--space-1) solid var(--secondary-500);
    color: var(--color-ink);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-block-end: var(--space-12);
    padding: var(--space-5) var(--space-6);
  }

  .event-ended span {
    color: var(--color-body);
  }

  .event-detail__layout {
    align-items: start;
    display: grid;
    gap: var(--space-16);
    grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.28fr);
  }

  .event-detail__layout--facts-only {
    grid-template-columns: minmax(0, 42rem);
    justify-content: center;
  }

  .event-facts {
    background: var(--base-100);
    border-block-start: var(--space-1) solid var(--secondary-500);
    padding: var(--space-8);
  }

  .event-facts__eyebrow,
  .event-copy__eyebrow {
    color: var(--color-terracotta-dark);
    margin-block-end: var(--space-6);
  }

  .event-fact {
    align-items: start;
    border-block-start: 1px solid var(--base-300);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: var(--space-6) 1fr;
    padding-block: var(--space-5);
  }

  .event-fact svg {
    fill: none;
    margin-block-start: var(--space-1);
    stroke: var(--primary-500);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .event-fact div {
    display: grid;
    gap: var(--space-1);
  }

  .event-fact span {
    color: var(--color-body);
    font-size: var(--text-sm);
  }

  .event-fact strong {
    color: var(--color-ink);
    font-size: var(--text-base);
  }

  .event-fact p {
    color: var(--color-body);
  }

  .event-fact a {
    color: var(--color-terracotta-dark);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-underline-offset: var(--space-1);
  }

  .event-facts__cta {
    align-items: center;
    background: var(--primary-500);
    border-radius: var(--radius-pill);
    color: var(--base-50);
    display: flex;
    font-weight: 800;
    gap: var(--space-3);
    justify-content: center;
    margin-block-start: var(--space-6);
    padding: var(--space-4) var(--space-6);
    text-decoration: none;
  }

  .event-facts__cta:hover {
    background: var(--primary-600);
  }

  .event-facts__cta svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: var(--space-5);
  }

  .event-copy {
    padding-block-start: var(--space-4);
  }

  .event-copy h2 {
    font-size: var(--text-3xl);
    margin-block-end: var(--space-8);
  }

  .event-copy__rich :global(p),
  .event-copy__rich :global(li) {
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .event-copy__rich :global(p + p),
  .event-copy__rich :global(ul),
  .event-copy__rich :global(ol) {
    margin-block-start: var(--space-5);
  }

  .event-copy__rich :global(a) {
    color: var(--color-terracotta-dark);
    font-weight: 700;
    text-underline-offset: var(--space-1);
  }

  .sr-only {
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    width: 1px;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .event-hero,
    .event-hero__inner {
      min-height: 34rem;
    }

    .event-hero__veil {
      background: linear-gradient(0deg, color-mix(in srgb, var(--primary-900) 94%, transparent), color-mix(in srgb, var(--primary-900) 42%, transparent));
    }

    .event-hero__content {
      padding-block-start: var(--space-12);
    }

    .event-hero__summary {
      font-size: var(--text-lg);
    }

    .event-detail__body {
      padding-block: var(--space-12) var(--space-16);
    }

    .event-detail__layout {
      gap: var(--space-12);
      grid-template-columns: 1fr;
    }

    .event-facts {
      padding: var(--space-6);
    }
  }
</style>
