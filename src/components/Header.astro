---
import { getNavLinks, type Lang } from '../lib/navigation';
import { getResolvedGrowNavItems } from '../lib/grow-pages';

interface Props {
  lang?: Lang;
  langToggleHref?: string;
  pageVisibility?: Record<string, boolean>;
}

const { lang = 'en', langToggleHref: langToggleHrefProp, pageVisibility: pageVisibilityProp } = Astro.props;
const logoHref = lang === 'zh' ? '/zh' : '/en/';
const logoText = lang === 'zh' ? '伊的家' : 'FICCC';
const logoLabel = lang === 'zh' ? '伊的家' : 'FICCC Home';
const langToggleLabel = lang === 'zh' ? '中文 / EN' : 'EN / 中文';
const navLabel = lang === 'zh' ? '主要導覽' : 'Main navigation';
const menuOpenLabel = lang === 'zh' ? '開啟導覽選單' : 'Open navigation menu';
const menuCloseLabel = lang === 'zh' ? '關閉導覽選單' : 'Close navigation menu';
const langToggleHref = langToggleHrefProp ?? (lang === 'zh' ? '/en/' : '/zh');
const currentPath = Astro.url.pathname;
const logoSrc = lang === 'zh' ? '/logo/logo-zh-light.svg' : '/logo/logo-en-light.svg';

// Dropdown configurations — keyed by the nav link href that triggers the dropdown
interface DropdownConfig {
  subLinks: { label: string; href: string }[];
  activePrefixes: string[]; // paths that make this dropdown show as active
}

const aboutPrefix = lang === 'zh' ? '/zh/about' : '/en/about';
const growPrefix = lang === 'zh' ? '/zh/grow' : '/en/grow';
const defaultGrowHref = lang === 'zh' ? '/zh/grow/chinese' : '/en/grow/english';
const pageVisibility = pageVisibilityProp ?? {};

const isVisible = (id: string) => pageVisibility[id] !== false;
const aboutSubLinks = [
  isVisible(`aboutPage-${lang}`)
    ? { label: lang === 'zh' ? '關於我們' : 'Who We Are', href: aboutPrefix }
    : null,
  isVisible(`beliefsPage-${lang}`)
    ? { label: lang === 'zh' ? '信仰與願景' : 'Beliefs & Vision', href: `${aboutPrefix}/beliefs` }
    : null,
].filter((link): link is { label: string; href: string } => Boolean(link));
const aboutHref = aboutSubLinks[0]?.href || aboutPrefix;
const resolvedGrowNavItems = await getResolvedGrowNavItems(lang, Astro.request);
const resourcesVisible = lang === 'en' && isVisible('resourcesPage-en');
const growNavItems = lang === 'en'
  ? [
      ...resolvedGrowNavItems,
      ...(resourcesVisible ? [{ label: 'Resources', href: '/en/resources' }] : []),
    ]
  : resolvedGrowNavItems;
const growHref = resolvedGrowNavItems[0]?.href || defaultGrowHref;

const pageIdByHref: Record<string, string> = {
  [lang === 'zh' ? '/zh' : '/en/']: `homePage-${lang}`,
  [lang === 'zh' ? '/zh/sundays' : '/en/visit']: `visitPage-${lang}`,
  [aboutPrefix]: `aboutPage-${lang}`,
  [lang === 'zh' ? '/zh/give' : '/en/give']: `givePage-${lang}`,
  [lang === 'zh' ? '/zh/contact' : '/en/contact']: `contactPage-${lang}`,
};

const navLinks = getNavLinks(lang)
  .filter((link) => {
    if (link.href === aboutPrefix) return aboutSubLinks.length > 0;
    if (link.href === defaultGrowHref) return growNavItems.length > 0;
    const pageId = pageIdByHref[link.href];
    return pageId ? isVisible(pageId) : true;
  })
  .map((link) => {
    if (link.href === aboutPrefix) return { ...link, href: aboutHref };
    if (link.href === defaultGrowHref) return { ...link, href: growHref };
    return link;
  });

const dropdowns: Record<string, DropdownConfig> = {};

if (aboutSubLinks.length > 0) {
  dropdowns[aboutHref] = {
    subLinks: aboutSubLinks,
    activePrefixes: [aboutPrefix],
  };
}

if (growNavItems.length > 0) {
  dropdowns[growHref] = {
    subLinks: growNavItems,
    activePrefixes: lang === 'en' ? [growPrefix, '/en/resources'] : [growPrefix],
  };
}
---

<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      <a href={logoHref} class="logo" aria-label={logoLabel}>
        <img src={logoSrc} alt={logoLabel} class="logo-img" width="220" height="44" />
      </a>
    </div>

    <div class="header-actions">
      <button
        class="hamburger"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label={menuOpenLabel}
        data-label-open={menuOpenLabel}
        data-label-close={menuCloseLabel}
      >
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
      </button>
    </div>

    <nav id="nav-menu" class="nav" aria-label={navLabel}>
      <ul class="nav-list" role="list">
        {navLinks.map((link) => {
          const dropdown = dropdowns[link.href];

          if (dropdown) {
            // Dropdown nav item (About, Grow)
            const dropdownActive = dropdown.activePrefixes.some(
              (prefix) => currentPath.startsWith(prefix)
            );
            return (
              <li class="nav-dropdown">
                <button
                  type="button"
                  class:list={['nav-link', 'nav-dropdown-trigger', { 'nav-link--active': dropdownActive }]}
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {link.label}
                  <svg class="nav-dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <ul class="nav-dropdown-panel" role="list">
                  {dropdown.subLinks.map((sub) => {
                    const subActive = currentPath === sub.href || currentPath === sub.href + '/';
                    return (
                      <li>
                        <a
                          href={sub.href}
                          class:list={['nav-link', 'nav-dropdown-link', { 'nav-link--active': subActive }]}
                          aria-current={subActive ? 'page' : undefined}
                        >
                          {sub.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </li>
            );
          }

          // Regular nav item
          const isActive = currentPath === link.href
            || (link.href !== '/' && link.href !== '/zh' && link.href !== '/en/' && currentPath.startsWith(link.href));

          return (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { 'nav-link--active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
      <a href={langToggleHref} class="lang-toggle" aria-label={lang === 'zh' ? '切換至英文' : 'Switch to Chinese'}>
        {langToggleLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-stone);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .logo-img {
    height: var(--site-header-logo-height);
    width: auto;
  }

  /* Desktop nav */
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .nav-list {
    display: flex;
    align-items: baseline;
    list-style: none;
    gap: var(--space-6);
  }
  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--base-800);
    text-decoration: none;
    padding: var(--space-1) 0;
    border-bottom: 2px solid transparent;
    transition: border-color var(--transition), color var(--transition);
  }
  .nav-link:hover {
    color: var(--primary-500);
    border-bottom-color: var(--primary-500);
  }
  .nav-link--active {
    color: var(--primary-600);
    border-bottom-color: var(--primary-500);
    font-weight: 600;
  }
  .nav-link:focus-visible {
    color: var(--primary-500);
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* Dropdowns (About, Grow) */
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    padding: var(--space-1) 0;
    margin: 0;
    /* Match .nav-link styles exactly — buttons don't inherit these */
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--base-800);
    line-height: normal;
  }
  .nav-dropdown-trigger.nav-link--active {
    color: var(--primary-600);
    border-bottom-color: var(--primary-500);
    font-weight: 600;
  }

  .nav-dropdown-chevron {
    transition: transform var(--transition);
  }
  @media (min-width: 768px) {
    .nav-dropdown:hover .nav-dropdown-chevron,
    .nav-dropdown:focus-within .nav-dropdown-chevron {
      transform: rotate(180deg);
    }
  }
  .nav-dropdown-panel {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 11rem;
    background: var(--color-bg);
    border: 1px solid var(--base-300);
    border-radius: var(--radius-lg);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    padding: var(--space-2);
    list-style: none;
    z-index: 200;
  }
  /* Invisible bridge between trigger and panel to prevent mouseout gap */
  .nav-dropdown-panel::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  @media (min-width: 768px) {
    .nav-dropdown:hover .nav-dropdown-panel,
    .nav-dropdown:focus-within .nav-dropdown-panel {
      display: block;
    }
  }
  .nav-dropdown-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-bottom: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    color: var(--base-800); /* darker than --base-700 for WCAG AA contrast in dropdown panel */
  }
  .nav-dropdown-link:hover {
    background: var(--base-100);
    border-bottom-color: transparent;
  }

  /* Language toggle */
  .lang-toggle {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    background: none;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition);
  }
  .lang-toggle:hover,
  .lang-toggle:focus-visible {
    background-color: var(--primary-500);
    color: var(--base-50);
    border-color: var(--primary-500);
  }
  .lang-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    margin-right: var(--space-4);
  }

  /* Hamburger — hidden on desktop */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    z-index: 110;
  }
  .hamburger-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 1px;
    transition: transform var(--transition), opacity var(--transition);
  }
  .hamburger:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .hamburger[aria-expanded='true'] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded='true'] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile */
  @media (max-width: 767px) {
    .header-actions {
      margin-left: 0;
      margin-right: 0;
    }
    .hamburger {
      display: flex;
    }

    .nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(75vw, 20rem);
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-16) var(--space-6) var(--space-8);
      background-color: var(--color-bg);
      border-left: 1px solid var(--color-stone);
      box-shadow: -4px 0 24px rgba(0, 0, 0, 0.08);
      transform: translateX(100%);
      transition: transform var(--transition);
      z-index: 105;
    }
    .nav.is-open {
      transform: translateX(0);
    }

    .nav-list {
      flex-direction: column;
      gap: var(--space-4);
    }
    .nav-link {
      font-size: var(--text-base);
    }

    /* Mobile: About as label with indented sub-links */
    .nav-dropdown {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
    .nav-dropdown-trigger {
      display: flex;
      pointer-events: none;
      font-size: var(--text-base);
      border-bottom: none;
    }
    .nav-dropdown-chevron {
      display: none;
    }
    .nav-dropdown-panel {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      position: static;
      transform: none;
      background: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
      padding: var(--space-2) 0 0 var(--space-4);
      margin: 0;
      min-width: 0;
    }
    .nav-dropdown-panel::before {
      display: none;
    }
    .nav-link {
      border-bottom: none;
    }
    .nav-link:hover {
      border-bottom-color: transparent;
    }
    .nav-dropdown-link {
      padding: 0;
      border-radius: 0;
      font-size: var(--text-sm);
      color: var(--base-800);
    }
  }
</style>

<script>
  const btn = document.querySelector('.hamburger') as HTMLButtonElement;
  const nav = document.querySelector('#nav-menu') as HTMLElement;
  const mobileQuery = window.matchMedia('(max-width: 767px)');

  if (btn && nav) {
    const dropdownTriggers = Array.from(nav.querySelectorAll<HTMLButtonElement>('.nav-dropdown-trigger'));
    const openLabel = btn.dataset.labelOpen || 'Open navigation menu';
    const closeLabel = btn.dataset.labelClose || 'Close navigation menu';

    function firstInteractiveItem() {
      return nav.querySelector<HTMLElement>('a:not([tabindex="-1"]), button:not([tabindex="-1"])');
    }

    function syncResponsiveState() {
      const isMobile = mobileQuery.matches;
      const isOpen = nav.classList.contains('is-open');

      nav.inert = isMobile && !isOpen;
      if (isMobile && !isOpen) nav.setAttribute('aria-hidden', 'true');
      else nav.removeAttribute('aria-hidden');

      dropdownTriggers.forEach((trigger) => {
        if (isMobile) {
          trigger.tabIndex = -1;
          trigger.setAttribute('aria-hidden', 'true');
          trigger.setAttribute('aria-expanded', 'true');
        } else {
          trigger.removeAttribute('tabindex');
          trigger.removeAttribute('aria-hidden');
          trigger.setAttribute('aria-expanded', 'false');
        }
      });
    }

    function openNav() {
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', closeLabel);
      nav.classList.add('is-open');
      syncResponsiveState();
      firstInteractiveItem()?.focus();
      document.addEventListener('focusin', trapFocus);
    }

    function closeNav(restoreFocus = true) {
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', openLabel);
      nav.classList.remove('is-open');
      document.removeEventListener('focusin', trapFocus);
      syncResponsiveState();
      if (restoreFocus) btn.focus();
    }

    function trapFocus(e: FocusEvent) {
      if (!nav.classList.contains('is-open')) return;
      if (!nav.contains(e.target as Node) && e.target !== btn) {
        firstInteractiveItem()?.focus();
      }
    }

    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        closeNav();
      } else {
        openNav();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        closeNav();
      }
    });

    dropdownTriggers.forEach((trigger) => {
      const dropdown = trigger.closest<HTMLElement>('.nav-dropdown');
      if (!dropdown) return;

      const setExpanded = (expanded: boolean) => {
        if (!mobileQuery.matches) trigger.setAttribute('aria-expanded', String(expanded));
      };

      dropdown.addEventListener('mouseenter', () => setExpanded(true));
      dropdown.addEventListener('mouseleave', () => {
        if (!dropdown.contains(document.activeElement)) setExpanded(false);
      });
      dropdown.addEventListener('focusin', () => setExpanded(true));
      dropdown.addEventListener('focusout', (event) => {
        if (!dropdown.contains(event.relatedTarget as Node | null)) setExpanded(false);
      });
    });

    mobileQuery.addEventListener('change', () => {
      if (!mobileQuery.matches && nav.classList.contains('is-open')) closeNav(false);
      else syncResponsiveState();
    });
    syncResponsiveState();
  }
</script>
