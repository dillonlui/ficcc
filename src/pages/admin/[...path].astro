---
/**
 * Sanity Studio client-side routes under /admin/*.
 *
 * Sanity generates nested intent and document-pane URLs (for example after
 * opening a document from Presentation). This route must be server-rendered
 * so every nested URL returns the Studio shell on a direct visit or refresh.
 */
export const prerender = false;

import Studio from '../../components/Studio';
---

<!doctype html>
<html lang="en" data-pagefind-ignore="all">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>FICCC Studio</title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        overflow: hidden;
      }
      #studio-root {
        height: 100vh;
        width: 100vw;
      }
    </style>
  </head>
  <body>
    <div id="studio-root">
      <Studio client:only="react" />
    </div>
  </body>
</html>
