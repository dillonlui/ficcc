---
import GrowPage from '../../../components/GrowPage.astro';
import { getResolvedGrowPage } from '../../../lib/grow-pages';

export const prerender = false;

const { content, isHidden } = await getResolvedGrowPage('zh', 'chinese', Astro.request);
if (isHidden) return Astro.redirect('/404');
---

<GrowPage lang="zh" content={content} />
