---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Accordion from '../../components/Accordion.astro';
import RideRequestForm from '../../components/RideRequestForm.astro';
import { hasSanityPreviewCookie, loadQuery, urlForImage, portableTextToHtml, type VisitPage } from '../../lib/sanity';

export const prerender = false;

const title = '主日聚會 | 伊的家華人基督教會';
const description =
  '您第一次來教會需要知道的一切：聚會時間、交通方式、停車資訊及注意事項。';

// ---------- CMS data (graceful fallback when Sanity is unreachable) ----------
let visitPage: VisitPage | null = null;
const isSanityPreviewRequest = hasSanityPreviewCookie(Astro.request);

try {
  const result = await loadQuery<VisitPage | null>(
    `*[_id == $id][0]`,
    { id: 'visitPage-zh' },
    { request: Astro.request },
  );
  visitPage = result.data;
} catch (error) {
  if (isSanityPreviewRequest) throw error;
  // Sanity unreachable — continue with fallbacks
}

if (visitPage?.isVisible === false) return Astro.redirect('/404');

// ---------- Fallback defaults ----------
const fallbackSchedule = [
  {
    label: '華語崇拜',
    time: '11:15 AM',
    description: '包含詩歌敬拜、禱告和聖經信息的崇拜聚會',
  },
  {
    label: '門徒小組',
    time: '11:00 AM',
    description: '討論和禱告的小組時間',
  },
];

const fallbackWhatToExpectHtml = `
<p>無論您是第一次來教會，還是曾經參加過其他教會，都歡迎您如實地來到這裡。</p>
<p><strong>穿著：</strong>隨意穿著即可，大多數人穿休閒服裝。</p>
<p><strong>主日流程：</strong>聚會包括詩歌敬拜、禱告、讀經和講道。崇拜以中文為主，部分環節為雙語。</p>
<p><strong>歡迎孩子：</strong>兒童隨時歡迎參加主堂崇拜。崇拜後我們也提供按年齡分組的主日學課程。</p>
<p><strong>聚會多長時間？</strong>主日崇拜通常約75分鐘。</p>
`;

const fallbackTransportationHtml = `
<p><strong>地址：</strong>429 Mitchell Street, Ithaca, NY 14850</p>
<p><strong>停車：</strong>教會旁設有免費停車場。Mitchell Street 及附近街道也有路邊停車位。</p>
<p><strong>靠近康奈爾：</strong>我們距離康奈爾大學校園很近。如果您是沒有車的學生，我們很樂意安排接送，請與我們聯繫！</p>
<p><strong>公共交通：</strong>TCAT公車可到達附近地區。請查詢 <a href="https://tcatbus.com">tcatbus.com</a> 了解時刻表。</p>
`;

// ---------- Bus Route (ZH-specific bespoke content) ----------
const busRouteHeading = visitPage?.busRouteHeading || '主日接送巴士路線';
const busRouteIntro = visitPage?.busRouteIntro || '每週日早上，教會提供免費接送巴士服務。以下為七站路線及預計到達時間：';
const busRoute = visitPage?.busRoute?.length
  ? visitPage.busRoute
  : [
      { stop: '教會（429 Mitchell St）', time: '9:00 AM' },
      { stop: 'Hasbrouck Apartments', time: '9:10 AM' },
      { stop: 'Collegetown（College Ave & Dryden）', time: '9:15 AM' },
      { stop: 'North Campus（Robert Purcell）', time: '9:22 AM' },
      { stop: 'Ithaca Commons', time: '9:30 AM' },
      { stop: 'East Hill Plaza', time: '9:35 AM' },
      { stop: '返回教會（429 Mitchell St）', time: '9:40 AM' },
    ];

const fallbackFaqItems = [
  {
    question: '應該穿什麼？',
    answer: '沒有穿著要求，隨意穿著即可。大多數人穿休閒服裝。',
  },
  {
    question: '歡迎兒童嗎？',
    answer:
      '當然！兒童隨時歡迎參加主堂崇拜，崇拜後我們也提供按年齡分組的主日學課程。',
  },
  {
    question: '崇拜使用什麼語言？',
    answer:
      '我們的崇拜以中文為主，部分環節為雙語（中英文）。無論您的語言背景如何，都歡迎您。',
  },
  {
    question: '有停車位嗎？',
    answer:
      '有！教會旁設有免費停車場，附近街道也有路邊停車位。',
  },
  {
    question: '聚會多長時間？',
    answer:
      '主日崇拜通常約75分鐘。主日學在11:15 AM開始，約45分鐘。',
  },
  {
    question: '平日如何聯繫教會？',
    answer:
      '我們很期待幫助您融入社區！聚會後請到歡迎桌了解小組、查經班和其他連結方式。您也可以通過我們的聯繫頁面與我們溝通。',
  },
];

// ---------- Resolved data (CMS ▸ fallback) ----------
const heroImage = visitPage?.heroImage
  ? urlForImage(visitPage.heroImage, { width: 1600 })
  : '/images/church/bbq-2025-group-wide.webp';
const heroTitle = visitPage?.heroTitle || '主日聚會';
const heroSubtitle =
  visitPage?.heroSubtitle ||
  '您第一次來教會需要知道的一切';

const schedule =
  visitPage?.schedule && visitPage.schedule.length > 0
    ? visitPage.schedule
    : fallbackSchedule;

const whatToExpectHtml =
  visitPage?.whatToExpect && visitPage.whatToExpect.length > 0
    ? portableTextToHtml(visitPage.whatToExpect)
    : fallbackWhatToExpectHtml;

const transportationHtml =
  visitPage?.transportation && visitPage.transportation.length > 0
    ? portableTextToHtml(visitPage.transportation)
    : fallbackTransportationHtml;

const faqItems =
  visitPage?.faqItems && visitPage.faqItems.length > 0
    ? visitPage.faqItems
    : fallbackFaqItems;

const accordionItems = faqItems.map((item) => ({
  title: item.question,
  content: item.answer,
}));

const showRideRequest = visitPage?.rideRequestEnabled !== false;

const rideRequestHeading = visitPage?.rideRequestHeading || '需要接送嗎？';
const rideRequestIntro = visitPage?.rideRequestIntro || '沒有車？沒問題，我們很樂意接送您！請填寫以下表格，我們的同工會與您聯繫安排接送。';
---

<BaseLayout title={title} description={description} lang="zh">
  <main id="main-content" data-pagefind-body class="visit-page">
    <Hero
      title={heroTitle}
      subtitle={heroSubtitle}
      backgroundImage={heroImage}
    />

    <div class="visit-intro-field">
      <div class="visit-intro-field__tex" style="background-image: url('/images/textures/kiwihug-qv05FvdE26k-unsplash.jpg')"></div>

      <!-- Sunday at a glance -->
      <section class="schedule" aria-label="主日聚會一覽">
        <div class="schedule__inner">
          <div class="schedule__rail" data-reveal>
            <div class="schedule__heading">
              <span class="schedule__kicker">主日聚會一覽</span>
              <span class="schedule__address">429 Mitchell Street</span>
            </div>
            <div class="schedule__events" data-reveal-stagger>
              {schedule.map((item) => (
                <div class="schedule__event" data-reveal>
                  <span class="schedule__time">{item.time}</span>
                  <span class="schedule__event-copy">
                    <span class="schedule__label">{item.label}</span>
                    {item.description && <span class="schedule__desc">{item.description}</span>}
                  </span>
                </div>
              ))}
            </div>
            <a
              class="schedule__directions"
              href="https://www.google.com/maps/search/?api=1&query=429+Mitchell+Street+Ithaca+NY+14850"
              target="_blank"
              rel="noopener noreferrer"
            >
              查看路線
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                <path d="M14 5h5v5M19 5l-8 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M19 13v5a1 1 0 01-1 1H6a1 1 0 01-1-1V6a1 1 0 011-1h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- What to Expect -->
      <section class="expect" aria-label="注意事項">
        <div class="expect__inner">
          <div class="section-intro" data-reveal>
            <p class="section-kicker">第一次來到我們當中</p>
            <h2 class="section-heading">注意事項</h2>
          </div>
          <div class="expect__body" data-reveal set:html={whatToExpectHtml} />
        </div>
      </section>
    </div>

    <!-- Transportation & Directions -->
    <section class="directions" aria-label="交通指引">
      <div class="directions__inner">
        <div class="section-intro" data-reveal>
          <p class="section-kicker">安心抵達</p>
          <h2 class="section-heading">如何到達</h2>
        </div>
        <div class="directions__columns" data-reveal>
          <div class="directions__body" set:html={transportationHtml} />
          <div class="directions__map">
            <iframe
              title="教會在Google地圖上的位置"
              src="https://www.google.com/maps?q=429+Mitchell+Street,+Ithaca,+NY+14850&output=embed"
              width="100%"
              height="300"
              style="border:0; border-radius: var(--radius-md);"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <a
              class="directions__map-link"
              href="https://www.google.com/maps/search/?api=1&query=429+Mitchell+Street+Ithaca+NY+14850"
              target="_blank"
              rel="noopener noreferrer"
            >
              在 Google 地圖中開啟
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Sunday Bus Route (ZH-specific) -->
    <section class="bus-route" aria-label="主日接送路線">
      <div class="bus-route__tex" style="background-image: url('/images/textures/valentin-beauvais-4YrVF0gVdjk-unsplash.jpg')"></div>
      <div class="bus-route__inner">
        <div class="bus-route__intro-block" data-reveal>
          <p class="bus-route__kicker">免費主日接送</p>
          <h2 class="bus-route__heading">{busRouteHeading}</h2>
          <p class="bus-route__intro">{busRouteIntro}</p>
        </div>
        <ol class="bus-route__list" data-reveal-stagger>
          {busRoute.map((stop, i) => (
            <li class="bus-route__stop" data-reveal>
              <span class="bus-route__number" aria-hidden="true">{i + 1}</span>
              <div class="bus-route__details">
                <span class="bus-route__name">{stop.stop}</span>
                <span class="bus-route__time">{stop.time}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq faq--textured" aria-label="常見問題">
      <div class="faq__tex" style="background-image: url('/images/textures/kiwihug-qv05FvdE26k-unsplash.jpg')"></div>
      <div class="faq__inner">
        <div class="faq__intro" data-reveal>
          <p class="section-kicker">來訪須知</p>
          <h2 class="section-heading">常見問題</h2>
          <p>第一次來訪還有疑問？以下是大家最常詢問的事項。</p>
        </div>
        <div class="faq__panel" data-reveal><Accordion items={accordionItems} /></div>
      </div>
    </section>

    <!-- Ride Request -->
    {showRideRequest && (
      <section id="ride-request" class="ride-request" aria-label="申請接送">
        <div class="ride-request__tex" style="background-image: url('/images/textures/valentin-beauvais-4YrVF0gVdjk-unsplash.jpg')"></div>
        <div class="ride-request__inner">
          <h2 class="ride-request__heading" data-reveal>{rideRequestHeading}</h2>
          <p class="ride-request__intro" data-reveal>
            {rideRequestIntro}
          </p>
          <RideRequestForm lang="zh" />
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<!-- Cloudflare Turnstile — loaded async for form spam protection -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  :global(.hero__img) {
    object-position: center 25%;
  }

  .visit-page {
    background: var(--color-bg);
  }

  .visit-intro-field {
    position: relative;
    display: flow-root;
    background: var(--primary-50);
  }

  .visit-intro-field__tex {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    pointer-events: none;
    opacity: 0.12;
    mix-blend-mode: multiply;
  }

  .section-intro {
    margin-block-end: var(--space-10);
  }

  .section-kicker {
    margin: 0 0 var(--space-2);
    color: var(--color-terracotta-dark);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .section-heading {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-ink);
    text-align: left;
  }

  .schedule {
    position: relative;
    z-index: 2;
    margin-block-start: calc(var(--space-12) * -1);
    padding: 0 var(--space-6);
    background: transparent;
  }

  .schedule__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-block-end: 0;
  }

  .schedule__rail {
    display: grid;
    grid-template-columns: minmax(11rem, 0.55fr) minmax(0, 1.5fr) auto;
    overflow: hidden;
    border: 1px solid var(--base-300);
    border-radius: var(--radius-xl);
    background: var(--base-50);
    box-shadow: 0 var(--space-4) var(--space-10) color-mix(in srgb, var(--primary-900) 12%, transparent);
  }

  .schedule__heading {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    border-inline-end: 1px solid var(--base-300);
    background: var(--base-50);
  }

  .schedule__kicker {
    color: var(--primary-600);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-tight);
  }

  .schedule__address {
    color: var(--base-700);
    font-size: var(--text-sm);
  }

  .schedule__events {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .schedule__event {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-6);
    border-inline-end: 1px solid var(--base-300);
  }

  .schedule__time {
    flex: 0 0 auto;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--primary-600);
    white-space: nowrap;
  }

  .schedule__event-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-1);
  }

  .schedule__label {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink);
  }

  .schedule__desc {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-body);
  }

  .schedule__directions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    color: var(--primary-700);
    background: var(--primary-100);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .schedule__directions:hover {
    color: var(--primary-800);
    background: var(--primary-200);
  }

  .expect {
    position: relative;
    overflow: hidden;
    padding: var(--space-20) var(--space-6);
    background-color: transparent;
  }

  .expect__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  .expect__body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-body);
  }

  .expect__body :global(p) {
    margin: 0;
    padding: var(--space-6);
    border: 1px solid var(--base-300);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--base-50) 92%, transparent);
  }

  .expect__body :global(p:first-child) {
    grid-column: 1 / -1;
    max-width: 46rem;
    padding: 0 0 var(--space-4);
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-lg);
  }

  .expect__body :global(strong) {
    display: block;
    margin-block-end: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .directions {
    padding: var(--space-20) var(--space-6);
    background-color: var(--color-bg);
  }

  .directions__inner {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .directions__columns {
    display: grid;
    grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-8);
    align-items: stretch;
  }

  .directions__body {
    overflow: hidden;
    border: 1px solid var(--base-300);
    border-radius: var(--radius-xl);
    background: var(--base-50);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-body);
  }

  .directions__body :global(p) {
    margin: 0;
    padding: var(--space-5) var(--space-6);
    border-block-end: 1px solid var(--base-300);
  }

  .directions__body :global(p:last-child) {
    border-block-end: 0;
  }

  .directions__body :global(strong) {
    display: block;
    margin-block-end: var(--space-1);
    color: var(--color-terracotta-dark);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .directions__body :global(a) {
    color: var(--primary-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .directions__map {
    position: relative;
    min-height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 var(--space-3) var(--space-8) color-mix(in srgb, var(--primary-900) 10%, transparent);
  }

  .directions__map iframe {
    display: block;
    height: 100%;
    min-height: 24rem;
  }

  .directions__map-link {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--base-300);
    border-radius: var(--radius-full);
    color: var(--primary-700);
    background: var(--base-50);
    box-shadow: 0 var(--space-2) var(--space-5) color-mix(in srgb, var(--primary-900) 18%, transparent);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    transition: transform 160ms ease, background-color 160ms ease;
  }

  .directions__map-link:hover {
    transform: translateY(-2px);
    background: var(--primary-50);
  }

  .bus-route {
    position: relative;
    overflow: hidden;
    padding: var(--space-20) var(--space-6);
    background-color: var(--primary-800);
  }

  .bus-route__tex {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    pointer-events: none;
    opacity: 0.18;
    mix-blend-mode: soft-light;
  }

  .bus-route__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-16);
    align-items: start;
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .bus-route__intro-block {
    position: sticky;
    top: var(--space-8);
  }

  .bus-route__kicker {
    margin: 0 0 var(--space-2);
    color: var(--primary-200);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .bus-route__heading {
    margin: 0;
    color: var(--base-50);
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
  }

  .bus-route__intro {
    max-width: 30rem;
    margin: var(--space-5) 0 0;
    color: var(--primary-100);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .bus-route__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
  }

  .bus-route__stop:not(:last-child)::after {
    content: '';
    position: absolute;
    left: var(--space-5);
    top: 50%;
    height: calc(100% + var(--space-4));
    width: 3px;
    background-color: var(--primary-300);
    border-radius: var(--radius-full);
    opacity: 0.65;
    transform: translateX(-50%);
    z-index: 0;
  }

  .bus-route__stop {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    position: relative;
  }

  .bus-route__number {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--primary-200);
    color: var(--primary-900);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    display: flex;
