---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Accordion from '../../components/Accordion.astro';
import RideRequestForm from '../../components/RideRequestForm.astro';
import { hasSanityPreviewCookie, loadQuery, urlForImage, portableTextToHtml, type VisitPage } from '../../lib/sanity';

export const prerender = false;

const title = 'Plan Your Visit | First Ithaca Chinese Christian Church';
const description =
  'Everything you need to know for your first Sunday with us. Service times, directions, parking, and what to expect.';

// ---------- CMS data (graceful fallback when Sanity is unreachable) ----------
let visitPage: VisitPage | null = null;
const isSanityPreviewRequest = hasSanityPreviewCookie(Astro.request);

try {
  const result = await loadQuery<VisitPage | null>(
    `*[_id == $id][0]`,
    { id: 'visitPage-en' },
    { request: Astro.request },
  );
  visitPage = result.data;
} catch (error) {
  if (isSanityPreviewRequest) throw error;
  // Sanity unreachable — continue with fallbacks
}

if (visitPage?.isVisible === false) return Astro.rewrite('/404');

// ---------- Fallback defaults ----------
const fallbackSchedule = [
  {
    label: 'Sunday Gathering',
    time: '9:45 AM',
    description:
      'Worship service with singing, prayer, and a message from Scripture',
  },
  {
    label: 'Sunday School',
    time: '11:15 AM',
    description:
      'Age-specific classes for children, youth, and adults',
  },
];

const fallbackWhatToExpectHtml = `
<p>Whether it's your first time at church or you've been part of a community before, you're welcome here just as you are.</p>
<p><strong>Dress code:</strong> Come as you are. Most people dress casually. You'll see everything from jeans to button-downs.</p>
<p><strong>What happens on Sunday:</strong> Our gathering includes worship through singing, prayer, Scripture reading, and a sermon. Services are primarily in English with occasional bilingual elements.</p>
<p><strong>Kids are welcome:</strong> Children are always welcome in the main service. We also offer age-appropriate Sunday School classes after the gathering.</p>
<p><strong>How long is the service?</strong> The Sunday gathering typically lasts about 75 minutes.</p>
`;

const fallbackTransportationHtml = `
<p><strong>Address:</strong> 429 Mitchell Street, Ithaca, NY 14850</p>
<p><strong>Parking:</strong> Free parking is available in our lot adjacent to the building. Street parking is also available on Mitchell Street and nearby side streets.</p>
<p><strong>Near Cornell:</strong> We're a short drive from Cornell University's campus. If you're a student without a car, we'd be happy to help arrange a ride. Just ask!</p>
<p><strong>Public transit:</strong> TCAT bus routes serve the area. Check <a href="https://tcatbus.com">tcatbus.com</a> for schedules.</p>
`;

const fallbackFaqItems = [
  {
    question: 'What should I wear?',
    answer:
      `There's no dress code. Come as you are. Most people dress casually.`,
  },
  {
    question: 'Are children welcome?',
    answer:
      'Absolutely! Children are welcome in the main service, and we offer Sunday School classes for different age groups after the gathering.',
  },
  {
    question: 'What language is the service in?',
    answer:
      'Our services are primarily in English with occasional bilingual (English/Chinese) elements. Everyone is welcome regardless of language background.',
  },
  {
    question: 'Is there parking available?',
    answer:
      'Yes! Free parking is available in our lot next to the building, and street parking is available nearby.',
  },
  {
    question: 'How long is the service?',
    answer:
      'The Sunday gathering typically lasts about 75 minutes. Sunday School classes follow at 11:15 AM and run for about 45 minutes.',
  },
  {
    question: 'How can I get connected during the week?',
    answer:
      `We'd love to help you find community! After the service, stop by the welcome table to learn about small groups, Bible studies, and other ways to connect. You can also reach out through our contact page.`,
  },
];

// ---------- Resolved data (CMS ▸ fallback) ----------
const heroImage = visitPage?.heroImage
  ? urlForImage(visitPage.heroImage, { width: 1600 })
  : '/images/church/bbq-2025-group-wide.webp';
const heroTitle = visitPage?.heroTitle || 'Plan Your Visit';
const heroSubtitle =
  visitPage?.heroSubtitle ||
  'Everything you need to know for your first Sunday with us';

const schedule =
  visitPage?.schedule && visitPage.schedule.length > 0
    ? visitPage.schedule
    : fallbackSchedule;

const whatToExpectHtml =
  visitPage?.whatToExpect && visitPage.whatToExpect.length > 0
    ? portableTextToHtml(visitPage.whatToExpect)
    : fallbackWhatToExpectHtml;

const transportationHtml =
  visitPage?.transportation && visitPage.transportation.length > 0
    ? portableTextToHtml(visitPage.transportation)
    : fallbackTransportationHtml;

const faqItems =
  visitPage?.faqItems && visitPage.faqItems.length > 0
    ? visitPage.faqItems
    : fallbackFaqItems;

// Map FAQ items to Accordion's expected shape
const accordionItems = faqItems.map((item) => ({
  title: item.question,
  content: item.answer,
}));

const showRideRequest = visitPage?.rideRequestEnabled !== false;

const rideRequestHeading = visitPage?.rideRequestHeading || 'Need a Ride?';
const rideMessengerMessage =
  visitPage?.rideMessengerMessage ||
  "Don't have a car? Sunday rides are arranged through our Messenger group chat. Join the group to request a pickup or to offer someone a ride.";
const rideMessengerButtonLabel =
  visitPage?.rideMessengerButtonLabel || 'Join Messenger Ride Group';
const rideMessengerUrl = visitPage?.rideMessengerUrl?.trim() || '';
const rideRequestIntro =
  visitPage?.rideRequestIntro ||
  'Prefer email instead? Fill out the form below and someone from our team will reach out to arrange a ride.';
---

<BaseLayout title={title} description={description}>
  <main id="main-content" data-pagefind-body class="visit-page">
    <Hero
      title={heroTitle}
      subtitle={heroSubtitle}
      backgroundImage={heroImage}
    />

    <div class="visit-intro-field">
      <div class="visit-intro-field__tex" style="background-image: url('/images/textures/kiwihug-qv05FvdE26k-unsplash.jpg')"></div>

      <!-- Sunday at a glance -->
      <section class="schedule" aria-label="Sunday at a glance">
        <div class="schedule__inner">
          <div class="schedule__rail" data-reveal>
            <div class="schedule__heading">
              <span class="schedule__kicker">Sunday at a glance</span>
              <span class="schedule__address">429 Mitchell Street</span>
            </div>
            <div class="schedule__events" data-reveal-stagger>
              {schedule.map((item) => (
                <div class="schedule__event" data-reveal>
                  <span class="schedule__time">{item.time}</span>
                  <span class="schedule__event-copy">
                    <span class="schedule__label">{item.label}</span>
                    {item.description && <span class="schedule__desc">{item.description}</span>}
                  </span>
                </div>
              ))}
            </div>
            <a
              class="schedule__directions"
              href="https://www.google.com/maps/search/?api=1&query=429+Mitchell+Street+Ithaca+NY+14850"
              target="_blank"
              rel="noopener noreferrer"
            >
              Get directions
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                <path d="M14 5h5v5M19 5l-8 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M19 13v5a1 1 0 01-1 1H6a1 1 0 01-1-1V6a1 1 0 011-1h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- What to Expect -->
      <section class="expect" aria-label="What to Expect">
        <div class="expect__inner">
          <div class="section-intro" data-reveal>
            <p class="section-kicker">Your first Sunday</p>
            <h2 class="section-heading">What to Expect</h2>
          </div>
          <div class="expect__body" data-reveal set:html={whatToExpectHtml} />
        </div>
      </section>
    </div>

    <!-- Transportation & Directions -->
    <section class="directions" aria-label="Transportation and Directions">
      <div class="directions__inner">
        <div class="section-intro" data-reveal>
          <p class="section-kicker">Arrive with confidence</p>
          <h2 class="section-heading">Getting Here</h2>
        </div>
        <div class="directions__columns" data-reveal>
          <div class="directions__body" set:html={transportationHtml} />
          <div class="directions__map">
            <iframe
              title="Church location on Google Maps"
              src="https://www.google.com/maps?q=429+Mitchell+Street,+Ithaca,+NY+14850&output=embed"
              width="100%"
              height="300"
              style="border:0; border-radius: var(--radius-md);"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <a
              class="directions__map-link"
              href="https://www.google.com/maps/search/?api=1&query=429+Mitchell+Street+Ithaca+NY+14850"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open in Google Maps
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq faq--textured" aria-label="Frequently Asked Questions">
      <div class="faq__tex" style="background-image: url('/images/textures/kiwihug-qv05FvdE26k-unsplash.jpg')"></div>
      <div class="faq__inner">
        <div class="faq__intro" data-reveal>
          <p class="section-kicker">Good to know</p>
          <h2 class="section-heading">Frequently Asked Questions</h2>
          <p>Still wondering about something? These are the questions first-time guests ask most often.</p>
        </div>
        <div class="faq__panel" data-reveal><Accordion items={accordionItems} /></div>
      </div>
    </section>

    <!-- Ride Request -->
    {showRideRequest && (
      <section id="ride-request" class="ride-request" aria-label="Request a Ride">
        <div class="ride-request__tex" style="background-image: url('/images/textures/valentin-beauvais-4YrVF0gVdjk-unsplash.jpg')"></div>
        <div class="ride-request__inner">
          <h2 class="ride-request__heading" data-reveal>{rideRequestHeading}</h2>

          <div class="ride-messenger" data-reveal>
            <p class="ride-messenger__message">{rideMessengerMessage}</p>
            {rideMessengerUrl && (
              <a
                class="ride-messenger__button"
                href={rideMessengerUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {rideMessengerButtonLabel}
                <svg class="ride-messenger__button-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M14 5h5v5M19 5l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M19 13v5a1 1 0 01-1 1H6a1 1 0 01-1-1V6a1 1 0 011-1h5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              </a>
            )}
          </div>

          <p class="ride-request__intro" data-reveal>
            {rideRequestIntro}
          </p>
          <RideRequestForm />
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<!-- Cloudflare Turnstile — loaded async for form spam protection -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  :global(.hero__img) {
    object-position: center 25%;
  }

  .visit-page {
    background: var(--color-bg);
  }

  .visit-intro-field {
    position: relative;
    display: flow-root;
    background: var(--primary-50);
  }

  .visit-intro-field__tex {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    pointer-events: none;
    opacity: 0.12;
    mix-blend-mode: multiply;
  }

  .section-intro {
    margin-block-end: var(--space-10);
  }

  .section-kicker {
    margin: 0 0 var(--space-2);
    color: var(--color-terracotta-dark);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-heading {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-ink);
    text-align: left;
  }

  .schedule {
    position: relative;
    z-index: 2;
    margin-block-start: calc(var(--space-12) * -1);
    padding: 0 var(--space-6);
    background: transparent;
  }

  .schedule__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-block-end: 0;
  }

  .schedule__rail {
    display: grid;
    grid-template-columns: minmax(11rem, 0.55fr) minmax(0, 1.5fr) auto;
    overflow: hidden;
    border: 1px solid var(--base-300);
    border-radius: var(--radius-xl);
    background: var(--base-50);
    box-shadow: 0 var(--space-4) var(--space-10) color-mix(in srgb, var(--primary-900) 12%, transparent);
  }

  .schedule__heading {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    border-inline-end: 1px solid var(--base-300);
    background: var(--base-50);
  }

  .schedule__kicker {
    color: var(--primary-600);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-tight);
  }

  .schedule__address {
    color: var(--base-700);
    font-size: var(--text-sm);
  }

  .schedule__events {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .schedule__event {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-6);
    border-inline-end: 1px solid var(--base-300);
  }

  .schedule__time {
    flex: 0 0 auto;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--primary-600);
    white-space: nowrap;
  }

  .schedule__event-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-1);
  }

  .schedule__label {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink);
  }

  .schedule__desc {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-body);
  }

  .schedule__directions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    color: var(--primary-700);
    background: var(--primary-100);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .schedule__directions:hover {
    color: var(--primary-800);
    background: var(--primary-200);
  }

  .expect {
    position: relative;
    overflow: hidden;
    padding: var(--space-20) var(--space-6);
    background-color: transparent;
  }

  .expect__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  .expect__body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-body);
  }

  .expect__body :global(p) {
    margin: 0;
    padding: var(--space-6);
    border: 1px solid var(--base-300);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--base-50) 92%, transparent);
  }

  .expect__body :global(p:first-child) {
    grid-column: 1 / -1;
    max-width: 46rem;
    padding: 0 0 var(--space-4);
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-lg);
  }

  .expect__body :global(strong) {
    display: block;
    margin-block-end: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .directions {
    padding: var(--space-20) var(--space-6);
    background-color: var(--color-bg);
  }

  .directions__inner {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .directions__columns {
    display: grid;
    grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-8);
    align-items: stretch;
  }

  .directions__body {
    overflow: hidden;
    border: 1px solid var(--base-300);
    border-radius: var(--radius-xl);
    background: var(--base-50);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-body);
  }

  .directions__body :global(p) {
    margin: 0;
    padding: var(--space-5) var(--space-6);
    border-block-end: 1px solid var(--base-300);
  }

  .directions__body :global(p:last-child) {
    border-block-end: 0;
  }

  .directions__body :global(strong) {
    display: block;
    margin-block-end: var(--space-1);
    color: var(--color-terracotta-dark);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .directions__body :global(a) {
    color: var(--primary-500);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .directions__body :global(a:hover) {
    color: var(--primary-600);
  }

  .directions__map {
    position: relative;
    min-height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 var(--space-3) var(--space-8) color-mix(in srgb, var(--primary-900) 10%, transparent);
  }

  .directions__map iframe {
    display: block;
    height: 100%;
    min-height: 24rem;
  }

  .directions__map-link {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--base-300);
    border-radius: var(--radius-full);
    color: var(--primary-700);
    background: var(--base-50);
    box-shadow: 0 var(--space-2) var(--space-5) color-mix(in srgb, var(--primary-900) 18%, transparent);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    transition: transform 160ms ease, background-color 160ms ease;
  }

  .directions__map-link:hover {
    transform: translateY(-2px);
    background: var(--primary-50);
  }

  .faq {
    position: relative;
    overflow: clip;
    padding: var(--space-20) var(--space-6);
    background-color: var(--base-100);
  }

  .faq--textured .faq__tex {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    pointer-events: none;
    opacity: 0.12;
    mix-blend-mode: multiply;
    z-index: 0;
  }

  .faq__inner {
    display: grid;
    grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-16);
    align-items: start;
    max-width: var(--max-width);
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  .faq__intro {
    position: sticky;
    top: var(--sticky-section-offset);
  }

  .faq__intro > p:last-child {
    max-width: 25rem;
    margin: var(--space-5) 0 0;
    color: var(--color-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .faq__panel {
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--base-300);
    border-radius: var(--radius-xl);
    background: var(--base-50);
    box-shadow: 0 var(--space-3) var(--space-8) color-mix(in srgb, var(--primary-900) 8%, transparent);
  }

  .ride-request {
    padding: var(--space-20) var(--space-6);
    background-color: var(--base-800);
    position: relative;
    overflow: hidden;
  }

  .ride-request__tex {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    pointer-events: none;
    opacity: 0.25;
    mix-blend-mode: soft-light;
    z-index: 0;
  }

  .ride-request__inner {
    max-width: 36rem;
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  .ride-request__heading {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--base-50);
    text-align: center;
    margin-block-end: var(--space-4);
  }

  .ride-messenger {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    margin-block-end: var(--space-10);
    padding-block-end: var(--space-10);
    border-block-end: 1px solid color-mix(in srgb, var(--base-50) 18%, transparent);
  }

  .ride-messenger__message {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--base-300);
    text-align: center;
  }

  .ride-messenger__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--base-50);
    background-color: var(--primary-500);
    padding: var(--space-3) var(--space-8);
    border-radius: 100vw;
    text-decoration: none;
    transition: background-color var(--transition), transform var(--transition);
  }

  .ride-messenger__button:hover {
    background-color: var(--primary-400);
    transform: translateY(-1px);
  }

  .ride-messenger__button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .ride-messenger__button-icon {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ride-messenger__button:hover .ride-messenger__button-icon {
    transform: translate(2px, -2px);
  }

  .ride-request__intro {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--base-300);
    text-align: center;
    margin-block-end: var(--space-10);
  }

  @media (max-width: 960px) {
    .schedule__rail {
      grid-template-columns: 1fr;
    }

    .schedule__heading {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      border-inline-end: 0;
      border-block-end: 1px solid var(--base-300);
    }

    .schedule__event:last-child {
      border-inline-end: 0;
    }

    .schedule__directions {
      padding-block: var(--space-4);
    }

    .faq__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .faq__intro {
      position: static;
    }
  }

  @media (max-width: 700px) {
    .section-heading {
      font-size: var(--text-2xl);
    }

    .schedule {
      margin-block-start: calc(var(--space-8) * -1);
