---
import GrowPage from '../../../components/GrowPage.astro';
import { getResolvedGrowPage } from '../../../lib/grow-pages';

export const prerender = false;

const { content, isHidden } = await getResolvedGrowPage('en', 'youth', Astro.request);
if (isHidden) return Astro.rewrite('/404');
---

<GrowPage content={content} />
