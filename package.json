{
  "name": "ficcc",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "First Ithaca Chinese Christian Church — unified bilingual website",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/preview-vercel-output.mjs",
    "astro": "astro",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "sanity:doctor": "sanity doctor",
    "sanity:seed": "tsx sanity/migrations/cm-content.ts",
    "sanity:seed:media": "tsx sanity/migrations/cm-media.ts",
    "sanity:seed:youtube": "tsx sanity/migrations/seed-youtube-channel-url.ts",
    "sanity:seed:branding": "tsx sanity/migrations/seed-site-branding.ts",
    "sanity:replace:splash-logo": "tsx sanity/migrations/replace-splash-logo.ts",
    "sanity:link:fellowships": "tsx sanity/migrations/link-chinese-fellowships.ts",
    "lhci": "npm run build && lhci autorun",
    "audit": "npm audit --audit-level=moderate",
    "test": "vitest run",
    "test:a11y": "npx @axe-core/cli http://localhost:4321/ http://localhost:4321/en/ http://localhost:4321/en/about/ http://localhost:4321/en/contact/ http://localhost:4321/en/privacy/ http://localhost:4321/zh/ http://localhost:4321/zh/contact/ http://localhost:4321/zh/privacy/ --load-delay 1000 --exit",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.7",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^7.26.2",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.2.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.2",
    "sanity": "^6.10.1",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@vercel/edge": "^1.3.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@sanity/sdk-react": "2.19.0",
    "@sanity/uuid": "3.0.3",
    "@vercel/frameworks": {
      ".": "3.32.0",
      "js-yaml": "3.15.1",
      "smol-toml": "1.6.1"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@lhci/cli": {
      "inquirer": "8.2.7",
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    },
    "external-editor": {
      ".": "3.1.0",
      "tmp": "0.2.7"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    },
    "ws": "8.21.1"
  }
}
